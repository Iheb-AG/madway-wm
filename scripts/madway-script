#!/usr/bin/env python3
"""Run a .madway command file. Quotes group arguments; no shell evaluation is used."""
import argparse
from pathlib import Path
import runpy
import shlex
import subprocess
import sys
import time

api = runpy.run_path(str(Path(__file__).resolve().with_name('madway-shell')))


def parse(source, base):
    commands = []
    for number, line in enumerate(source.splitlines(), 1):
        if not line.strip() or line.lstrip().startswith('#'):continue
        try:
            words = shlex.split(line)
            name, args = words[0], words[1:]
            message = None
            if name == 'exec' and args:
                commands.append(('exec', args));continue
            if name == 'wait' and len(args) == 1 and 0 <= int(args[0]) <= 60000:
                commands.append(('wait', int(args[0])));continue
            if name in ('workspace', 'move') and len(args) == 1 and 1 <= int(args[0]) <= 9:
                message = dict(action='workspace' if name == 'workspace' else 'move-workspace', value=int(args[0])-1)
            elif name == 'window' and len(args) == 1 and args[0] in ('toggle-floating', 'toggle-above', 'maximize', 'fullscreen', 'close'):
                message = dict(action='window-'+('floating' if args[0] == 'toggle-floating' else 'above' if args[0] == 'toggle-above' else args[0]))
            elif name == 'tile' and len(args) == 1 and args[0] in ('left', 'right', 'up', 'down'):
                message = dict(action='tile', direction=args[0])
            elif name == 'overlay' and len(args)==1 and args[0] in ('toggle','stop'):
                message = dict(action='overlay-'+args[0])
            elif name == 'overlay' and len(args)==1 and args[0] in api['demoscenes']():
                message = dict(action='overlay-start', scene=args[0])
            elif name == 'theme' and len(args) == 1:
                message = dict(action='script-config', updates={'appearance.theme':args[0]})
            elif name == 'set' and len(args) == 2:
                message = dict(action='script-config', updates={args[0]:args[1]})
            elif name == 'background' and len(args) == 2 and args[0] == 'color':
                message = dict(action='script-config', updates={'wallpaper.type':'color','wallpaper.color':args[1]})
            elif name == 'background' and len(args) in (2,3) and args[0] == 'image':
                path = Path(args[1]).expanduser()
                if not path.is_absolute():path = base/path
                message = dict(action='script-config', updates={'wallpaper.type':'image','wallpaper.path':str(path),
                    'wallpaper.mode':args[2] if len(args)==3 else 'fill'})
            if message is None:raise ValueError('unknown command or invalid arguments')
            if message['action']=='script-config':api['validate_script_updates'](message['updates'])
            commands.append(('action', message))
        except (ValueError, RuntimeError) as error:
            raise ValueError(f'Line {number}: {error}') from error
    return commands


def main():
    parser=argparse.ArgumentParser(description=__doc__)
    parser.add_argument('file',type=Path)
    parser.add_argument('--check',action='store_true',help='Validate without executing commands')
    options=parser.parse_args()
    try:
        commands=parse(options.file.read_text(), options.file.resolve().parent)
        if options.check:
            print(f'{len(commands)} commands valid');return
        for kind, value in commands:
            if kind=='exec':subprocess.Popen(value, start_new_session=True)
            elif kind=='wait':time.sleep(value/1000)
            else:
                message=dict(value);name=message.pop('action')
                api['action'](name, **message)
    except (OSError, ValueError, RuntimeError) as error:
        parser.exit(1, f'madway-script: {error}\n')


if __name__=='__main__':main()
