import runpy
import shutil
import shlex
import signal
import socket
import subprocess
import sys
import tempfile

SHARE = Path(__file__).resolve().parent.parent / "share" / "madway"
SETTINGS_PAGES = ("Windows", "Displays", "Appearance", "Desktop", "Input", "Keyboard", "Mouse & touchpad", "Notifications", "Audio & brightness", "Power", "Session", "Panel")
CONFIG = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "madway" / "settings.ini"
DEFAULTS = {
    "appearance": {"theme": "black", "title_height": "14", "tile_gap": "1"},
    "windows": {"default_mode": "floating", "master_percent": "50", "animate":"true", "animation_ms":"360"},
    "motion":{"version":"2"},
    "desktop":{"icons":"true","folder":"","icon_size":"40"},
