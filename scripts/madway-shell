def settings():
    config = configparser.ConfigParser(interpolation=None)
    config.read_dict(DEFAULTS)
    stored=configparser.ConfigParser(interpolation=None);stored.read(CONFIG)
    config.read_dict({section:dict(stored.items(section)) for section in stored.sections()})
    legacy={'gershwin':'argent','gershwin-dark':'argent-dark'}
    config['appearance']['theme']=legacy.get(config.get('appearance','theme'),config.get('appearance','theme'))
    if not stored.has_option('sounds','logon') and config.get('sounds','startup').strip():
        parent=Path(config.get('sounds','startup')).expanduser().parent
        candidate=next((parent/name for name in ('logon.ogg','login.ogg','logon.wav','login.wav','logon.mp3','login.mp3') if (parent/name).is_file()),None)
        if candidate:config['sounds']['logon']=str(candidate)
    if stored.getint('motion','version',fallback=0)<2:
        for section,legacy,current in [('windows','180','360'),('workspaces','220','420'),('dock','180','240')]:
            if config.get(section,'animation_ms')==legacy:config[section]['animation_ms']=current
    return config


def panel_label(config=None):
    value = (config or settings()).get('panel','label').strip() or '@user'
    if value == '@user':value = pwd.getpwuid(os.getuid()).pw_name
    return ''.join(character for character in value if character.isprintable())[:64] or 'groxiv'


def themes():
    profiles = configparser.ConfigParser(interpolation=None)
    profiles.read(SHARE / 'themes.ini')
    return profiles


def palette(config=None):
    config=config or settings();profiles=themes();name=config.get('appearance','theme')
    values=dict(profiles[name if name in profiles else 'black'])
    if config.getboolean('appearance','custom_colors',fallback=False):
        for key,value in config.items('colors'):
            if key in values and re.fullmatch(r'#[0-9a-fA-F]{6}',value):values[key]=value
    return values


def icon_theme(config):
    from gi.repository import Gtk
    name=config.get('appearance','icon_theme',fallback='').strip()
    if name:Gtk.Settings.get_default().set_property('gtk-icon-theme-name',name)


def font_style(config):
    name=config.get('appearance','font',fallback='').strip();size=config.getint('appearance','text_size',fallback=0)
    css=('font-family: '+json.dumps(name,ensure_ascii=False)+';' if name and all(c.isprintable() for c in name) else '')
    if size:css+=f'font-size: {min(20,max(9,size))}px;'
    return '\n* , .settings-window *, .audio-menu .audio-mixer label, .switcher-surface label, .media-card label { '+css+' }' if css else ''


def panel_style(config):
    padding=min(32,max(0,config.getint('panel','padding')))
    size=config.getint('panel','text_size')
    return f'\n.bar.top, .bar.bottom {{ padding: 0 {padding}px; }} .bar.left, .bar.right {{ padding: {padding}px 0; }}'+(f' .bar button, .bar label {{ font-size: {min(20,max(9,size))}px; }}' if size else '')


def desktop_preset(config, name):
    """Apply geometry and background together, preserving unrelated preferences."""
    if name not in {'argent','argent-dark'}:raise ValueError('Unknown desktop preset')
    config['appearance'].update(theme=name, title_height='22')
    config['panel'].update(enabled='true', position='top', height='22', metrics='false')
    config['dock'].update(enabled='true',position='bottom')
    wallpaper = SHARE/'wallpapers'/'Abstract Blue.png'
    config['wallpaper'].update(type='image' if wallpaper.is_file() else 'color',
        path=str(wallpaper) if wallpaper.is_file() else '', mode='stretch', color='#5f6770')
    return config


def write_settings(config):
    CONFIG.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile('w', dir=CONFIG.parent, delete=False) as temporary:
        config.write(temporary);temporary_path = Path(temporary.name)
    temporary_path.replace(CONFIG)


def theme_style(style, config=None):
    config = config or settings()
    profiles = themes()
    name = config.get('appearance', 'theme')
    if name not in profiles:name = 'black'
    colors = palette(config)
    replacements = dict.fromkeys(('#000000', '#050505'), colors['background'])
    replacements.update(dict.fromkeys(('#080808', '#101010'), colors['surface']))
    replacements.update(dict.fromkeys(('#c8c8c8', '#eeeeee', '#ffffff', '#bdbdbd', '#d0d0d0'), colors['text']))
    replacements.update(dict.fromkeys(('#909090', '#626262'), colors['muted']))
    replacements.update(dict.fromkeys(('#282828', '#303030', '#555555', '#383838'), colors['border']))
    replacements.update(dict.fromkeys(('#202020', '#222222'), colors['active']))
    replacements.update(dict.fromkeys(('#b0b0b0', '#cccccc', '#dddddd', '#888888', '#666666'), colors['accent']))
    result = re.sub(r'#[0-9a-fA-F]{6}', lambda match:replacements.get(match[0].lower(), match[0]), style)
    if name in {'argent','argent-dark'}:
        if '{' in style:
            result += '\n'+(SHARE/'argent-common.css').read_text()
            if '.bar' in style:result += '\n'+(SHARE/'argent-panel.css').read_text()
            elif '#input' in style:result += '\n#input { background: white; border-radius: 9px; margin: 5px; border: 1px solid #999999; } #entry:selected, #text:selected { color: white; }'
            if name == 'argent-dark':result += '\n'+(SHARE/'argent-dark.css').read_text()
        else:
            result = re.sub(r'^font=.*$', 'font=Inter Medium 10', result, flags=re.M)
            result = re.sub(r'^border-radius=.*$', 'border-radius=6', result, flags=re.M)
    if '{' in style:
        result+=font_style(config)
        selected=contrast_text(colors['active'])
        # GTK popup menus and chooser views are separate windows: do not let
        # host light-theme backgrounds combine with this process's dark labels.
        result+=f'''
menu, menuitem, popover, messagedialog, filechooser, treeview.view {{ background-color: {colors['surface']}; color: {colors['text']}; }}
menu label, menuitem label, popover label, messagedialog label, filechooser label, tooltip label {{ color: {colors['text']}; }}
tooltip {{ background-color: {colors['surface']}; color: {colors['text']}; border-color: {colors['border']}; }}
menuitem:hover, menuitem:focus, treeview.view:selected {{ background: {colors['active']}; color: {selected}; }}
menuitem:hover label, menuitem:focus label, .settings-window button:active label {{ color: {selected}; }}
'''
        if config.getboolean('appearance','custom_colors',fallback=False):
            result+=f"\n.menu, .bar {{ background: {colors['surface']}; color: {colors['text']}; border-color: {colors['border']}; }} .menu label, .bar label {{ color: {colors['text']}; }} .menu button:hover, .bar button:hover {{ background: {colors['active']}; }}"
    return result


def contrast_text(color):
    channels=[int(color[i:i+2],16)/255 for i in (1,3,5)]
    linear=[c/12.92 if c<=.04045 else ((c+.055)/1.055)**2.4 for c in channels]
    luminance=sum(c*w for c,w in zip(linear,(.2126,.7152,.0722)))
    return '#000000' if luminance>.179 else '#ffffff'


def overlay_style(filename,config=None):
    """Palette-aware overlays keep their own geometry, separate from GTK menus."""
    config=config or settings();profiles=themes();name=config.get('appearance','theme')
    if name not in profiles:name='black'
    values=palette(config);values['font']=json.dumps(config.get('appearance','font')) if config.get('appearance','font').strip() else 'Inter, sans-serif' if name.startswith('argent') else 'monospace'
    if name=='argent':values['muted']='#6f737a'
    values['selection_text']=contrast_text(values['active'])
    return re.sub(r'@([a-z_]+)@',lambda match:values[match[1]],(SHARE/filename).read_text())+font_style(config)


def validate_script_updates(updates):
    choices = {
        'appearance.theme':set(themes().sections()),
        'panel.position':{'top','bottom','left','right'},
        'session_effects.mode':{'none','fade','shader'},
        'session_effects.shader':set(runpy.run_path(str(Path(__file__).with_name('madway_exit.py')))['SHADERS']),
        'input.focus_follows_mouse':{'true','false'}, 'input.modifier':{'alt','super'},
        'windows.default_mode':{'floating','tiled'}, 'wallpaper.type':{'color','image'},
        'wallpaper.mode':{'fill','fit','center','stretch','tile'},
    }
    bounds = {'session_effects.duration_ms':(160,1600),'appearance.title_height':(12,24),'appearance.tile_gap':(0,12),
              'windows.master_percent':(25,75), 'input.repeat_rate':(1,100),'input.repeat_delay':(100,1500)}
    if not isinstance(updates, dict) or not updates:raise ValueError('Empty settings command')
    for field, value in updates.items():
        if not isinstance(value, str):raise ValueError('Setting values must be text')
        if field in choices:
            if value not in choices[field]:raise ValueError('Invalid value for '+field)
        elif field in bounds:
            low, high = bounds[field]
            if not low <= int(value) <= high:raise ValueError(f'{field} must be {low}..{high}')
        elif field == 'wallpaper.color':
            if not re.fullmatch(r'#[0-9a-fA-F]{6}', value):raise ValueError('Color must be #RRGGBB')
        elif field == 'wallpaper.path':
            if not Path(value).expanduser().is_file():raise ValueError('Wallpaper image does not exist')
        else:raise ValueError('Unknown setting: '+field)


def demoscenes():
    """Load the optional local catalogue; scene content is not part of the desktop."""
    for path in (SHARE/'demoscenes.json', Path(__file__).resolve().parent.parent/'extras/demoscene/scenes.json'):
        try:
            entries = json.loads(path.read_text())
            return {key:value for key,value in entries.items()
                    if re.fullmatch(r'[a-z0-9_-]+', key) and isinstance(value, dict) and isinstance(value.get('title'), str)}
        except (OSError, ValueError, AttributeError, TypeError):continue
    return {}


def runtime_directory():
    display = os.environ.get("WAYLAND_DISPLAY", "")
    if not display or "/" in display:
        raise RuntimeError("WAYLAND_DISPLAY must name a running madway socket")
    return Path(os.environ["XDG_RUNTIME_DIR"]) / ("madway-" + display)


def action(name, **values):
    with socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM) as channel:
        channel.sendto(json.dumps({"action": name, **values}).encode(), str(runtime_directory() / "control.sock"))


def run(arguments):
    result = subprocess.run(arguments, capture_output=True, text=True, timeout=4)
    if result.returncode:
        raise RuntimeError(result.stderr.strip() or f"{arguments[0]} failed")
    return result.stdout.strip()


def volume():
    text = run(["wpctl", "get-volume", "@DEFAULT_AUDIO_SINK@"])
    match = re.search(r"Volume:\s*([0-9.]+)", text)
    if not match:
        raise RuntimeError("No default audio output")
    return round(float(match[1]) * 100), "MUTED" in text


def audio_snapshot():
    """PulseAudio JSON API, also provided by PipeWire's pulse server."""
    info = json.loads(run(["pactl", "--format=json", "info"]))
    groups = []
    for kind, title in (("sink", "Outputs"), ("source", "Inputs"),
                        ("sink-input", "Applications · playback"),
                        ("source-output", "Applications · recording")):
        entries = json.loads(run(["pactl", "--format=json", "list", kind+"s"]))
        rows = []
        for entry in entries:
            # Monitor sources capture a device's playback, rather than a microphone.
            props = entry.get("properties", {})
            levels = [float(v["value_percent"].rstrip("%")) for v in entry.get("volume", {}).values()]
            name = entry.get("name", str(entry["index"]))
            label = entry.get("description") or props.get("application.name") or props.get("media.name") or name
            if kind in ("sink-input", "source-output") and props.get("media.name"):
                label += " — " + props["media.name"] if label != props["media.name"] else ""
            default = info.get("default_sink_name" if kind == "sink" else "default_source_name") == name
            rows.append(dict(kind=kind, id=int(entry["index"]), name=name, label=label,
                             volume=round(sum(levels)/len(levels)) if levels else 0,
                             mute=bool(entry.get("mute", False)), default=default,
                             adjustable=bool(levels)))
        groups.append((title, rows))
    return groups


def audio_control(message):
    kind = message.get("kind")
    operation = message.get("operation")
    if kind not in {"sink", "source", "sink-input", "source-output"}:
        raise RuntimeError("Invalid audio resource")
    identity = str(int(message["id"]))
    if int(identity) < 0:raise RuntimeError("Invalid audio resource ID")
    if operation == "volume":
        command = ["set-"+kind+"-volume", identity, str(min(100, max(0, int(message["value"]))))+"%"]
    elif operation == "mute":
        command = ["set-"+kind+"-mute", identity, "1" if message.get("value") else "0"]
    elif operation == "default" and kind in {"sink", "source"}:
        command = ["set-default-"+kind, identity]
    else:
        raise RuntimeError("Invalid audio operation")
    run(["pactl", *command])


def battery_state(root=None):
    """Read only system batteries, keeping charge and energy units distinct."""
    root = Path(root or os.environ.get('MADWAY_POWER_SUPPLY_PATH', '/sys/class/power_supply'))
    def read(path, name):
        try:return (path/name).read_text().strip()
        except OSError:return None
    def number(path, name):
        try:
            value = float(read(path,name))
            return value if math.isfinite(value) and value >= 0 else None
        except (TypeError, ValueError):return None
    batteries=[];supplies=[]
    try:devices=sorted(root.iterdir())
    except OSError:devices=[]
    for device in devices:
        if read(device,'scope') == 'Device':continue
        kind=read(device,'type')
        if kind != 'Battery':
            online=read(device,'online')
            if online in ('0','1'):supplies.append(online=='1')
            continue
        if read(device,'present') == '0':continue
        now,full=number(device,'energy_now'),number(device,'energy_full')
        charge_now,charge_full=number(device,'charge_now'),number(device,'charge_full')
        voltage=number(device,'voltage_now') or number(device,'voltage_min_design')
        if (now is None or not full) and voltage and charge_now is not None and charge_full:
            now,full=charge_now*voltage/1e6,charge_full*voltage/1e6
        percent=number(device,'capacity')
        if percent is None and full and now is not None:percent=100*now/full
        if percent is None and charge_full and charge_now is not None:percent=100*charge_now/charge_full
        if percent is not None:percent=min(100,max(0,round(percent)))
        power=number(device,'power_now')
        if not power and voltage:
            current=number(device,'current_now')
            if current is not None:power=current*voltage/1e6
        batteries.append(dict(name=device.name,percent=percent,status=read(device,'status') or 'Unknown',
                              energy_now=now,energy_full=full,power=power))
    percent=None
    if batteries and all(row['energy_now'] is not None and row['energy_full'] for row in batteries):
        percent=round(100*sum(row['energy_now'] for row in batteries)/sum(row['energy_full'] for row in batteries))
    elif batteries and all(row['percent'] is not None for row in batteries):
        percent=round(sum(row['percent'] for row in batteries)/len(batteries))
    if len(batteries)==1:percent=batteries[0]['percent']
    if percent is not None:percent=min(100,max(0,percent))
    statuses={row['status'] for row in batteries}
    status='Discharging' if 'Discharging' in statuses else 'Charging' if 'Charging' in statuses else 'Full' if statuses=={'Full'} else 'Not charging' if 'Not charging' in statuses else 'Unknown'
    on_ac=any(supplies) if supplies else None
    seconds=None
    if batteries and len(statuses)==1 and status in ('Charging','Discharging') and all(
            row['energy_now'] is not None and row['energy_full'] and row['power'] for row in batteries):
        energy=sum(row['energy_now'] if status=='Discharging' else max(0,row['energy_full']-row['energy_now']) for row in batteries)
        seconds=round(3600*energy/sum(row['power'] for row in batteries))
    return dict(present=bool(batteries),percent=percent,status=status,on_ac=on_ac,seconds=seconds,batteries=batteries)


def battery_severity(state, low=20, critical=10):
    percent=state.get('percent')
    draining=state.get('status')=='Discharging' or (state.get('on_ac') is False and state.get('status') not in ('Charging','Full'))
    if not state.get('present') or percent is None or not draining:return 0
    return 2 if percent<=critical else 1 if percent<=low else 0


class BatteryAlerts:
    def __init__(self):self.level=0
    def update(self,state,low=20,critical=10,enabled=True):
        percent=state.get('percent')
        if not enabled or not state.get('present') or percent is None or state.get('status') in ('Charging','Full') or (
                state.get('on_ac') is True and state.get('status')!='Discharging'):
            self.level=0;return None
        if percent>=low+5:self.level=0
        severity=battery_severity(state,low,critical)
        if severity>self.level:
            self.level=severity;return 'critical' if severity==2 else 'low'
        return None


def power_snapshot():
    try:return json.loads((runtime_directory()/'power.json').read_text())
    except (OSError, ValueError):return dict(present=False)


def backlight():
    devices = sorted(Path("/sys/class/backlight").glob("*"))
    if not devices:
        return None
    device = devices[0]
    return device, int((device / "brightness").read_text()), int((device / "max_brightness").read_text())


def brightness():
    if shutil.which("brightnessctl"):
        current = int(run(["brightnessctl", "get"]))
        maximum = int(run(["brightnessctl", "max"]))
    else:
        hardware = backlight()
        if hardware is None:
            return None
        _, current, maximum = hardware
    return round(100 * current / maximum) if maximum else None


def set_brightness(percent):
    percent = min(100, max(1, int(percent)))
    if shutil.which("brightnessctl"):
        run(["brightnessctl", "set", f"{percent}%"])
        return
    hardware = backlight()
    if hardware is None:
        raise RuntimeError("No backlight device available")
    device, _, maximum = hardware
    value = max(1, round(maximum * percent / 100))
    # logind checks the caller's session/device access; no sudo or permission changes.
    run(["busctl", "--system", "call", "org.freedesktop.login1",
         "/org/freedesktop/login1/session/auto", "org.freedesktop.login1.Session",
         "SetBrightness", "ssu", "backlight", device.name, str(value)])


class Desktop:
    def __init__(self, compositor_pid):
        import gi
        from gi.repository import Gio, GLib, GLibUnix
        self.Gio, self.GLib = Gio, GLib
        self.parent = compositor_pid
        self.directory = runtime_directory()
        self.directory.mkdir(mode=0o700, parents=True, exist_ok=True)
        self.channel = socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM)
        self.socket_path = self.directory / "control.sock"
        if self.socket_path.exists():
            raise RuntimeError("A desktop helper already owns this display")
        self.channel.bind(str(self.socket_path))
        self.channel.setblocking(False)
        self.loop = GLib.MainLoop()
        self.children = {}
        self.ids = {}
        self.notification_bus = None
        self.battery_alerts = BatteryAlerts()
        self.notification_options = None
        self.panel_options = None
        self.dock_options = None
        self.settings_page = "Windows"
        self.exit_event = "logout"
        self.shutdown_played = False
        self.exit_sound_played = False
        self.config = settings()
        GLib.io_add_watch(self.channel.fileno(), GLib.IO_IN, self.receive)
        GLibUnix.signal_add(GLib.PRIORITY_DEFAULT, signal.SIGTERM, self.stop)
        GLibUnix.signal_add(GLib.PRIORITY_DEFAULT, signal.SIGINT, self.stop)
        GLib.timeout_add_seconds(1, self.reap)
        GLib.timeout_add_seconds(5, self.poll_power)
        try:
            self.system_bus = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
            self.system_bus.signal_subscribe("org.freedesktop.login1", "org.freedesktop.login1.Manager",
                "PrepareForShutdown", "/org/freedesktop/login1", None, Gio.DBusSignalFlags.NONE,
                self.prepare_shutdown)
        except GLib.Error:
            self.system_bus = None
        self.locker=runpy.run_path(str(Path(__file__).with_name('madway_lock.py')))['LockController'](self,SHARE)
        self.power = runpy.run_path(str(Path(__file__).with_name('madway_power.py')))['PowerManager'](self)
        self.background = runpy.run_path(str(Path(__file__).with_name('madway_wallpaper.py')))['WallpaperController'](self)
        self.desktop_options=None
        self.media_output=None
        self.media_options=None
        self.menu_origin=None
        self.pin_defs=[];self.pin_payloads={}
        self.apps=runpy.run_path(str(Path(__file__).with_name('madway_apps.py')))
        self.media=runpy.run_path(str(Path(__file__).with_name('madway_media.py')))['MediaController'](self,
            dict(run=run,volume=volume,brightness=brightness,set_brightness=set_brightness))
        self.session_exit=runpy.run_path(str(Path(__file__).with_name('madway_exit.py')))['SessionExitController'](self)
        GLib.timeout_add(150,self.poll_pins)
        GLib.timeout_add_seconds(2,self.poll_session_power)

    def poll_session_power(self):
        try:return self.power.sync()
        except Exception as error:
            print('madway: session power: '+str(error),file=sys.stderr);return True

    def spawn(self, key, arguments):
        existing = self.children.get(key)
        if existing is not None and existing.poll() is None:
            return existing
        try:
            process = subprocess.Popen(arguments)
        except FileNotFoundError:
            print(f"madway: optional desktop program missing: {arguments[0]}", file=sys.stderr)
            return None
        self.children[key] = process
        return process

    def terminate(self, key):
        process = self.children.pop(key, None)
        if process is not None and process.poll() is None:
            process.terminate()
            try:
                process.wait(timeout=1)
            except subprocess.TimeoutExpired:
                process.kill()
                process.wait()

    def reap(self):
        for key, process in list(self.children.items()):
            if process.poll() is not None:
                if process.returncode:
                    print(f"madway: {key} exited with status {process.returncode}", file=sys.stderr)
                del self.children[key]
        return True

    def sound(self, event, wait=False):
        if not self.config.getboolean("sounds", "enabled"):
            return
        configured = self.config.get("sounds", event).strip()
        if not configured:
            return
        path = Path(configured).expanduser()
        if not path.is_file():
            return
        gain = min(1, max(0, self.config.getfloat("sounds", "volume")))
        if shutil.which("pw-play"):
            arguments = ["pw-play", "--volume", str(gain), str(path)]
        elif shutil.which("paplay"):
            arguments = ["paplay", "--volume", str(round(gain * 65536)), str(path)]
        else:
            return
        process = self.spawn("sound-" + event, arguments)
        if wait and process is not None:
            try:
                process.wait(timeout=8)
            except subprocess.TimeoutExpired:
                self.terminate("sound-" + event)

        return process

    def notify(self, key, title, body="", value=None, urgency="normal", timeout=1500,previous=None,pending=False):
        if not self.config.getboolean("notifications", "enabled"):
            return False
        if key in {"volume", "brightness"} and not self.config.getboolean("notifications", "indicators"):
            return
        if key in {'volume','brightness'} and value is not None:
            try:
                state=json.loads((self.directory/'desktop.json').read_text())
                output=(state.get('output_x',0),state.get('output_y',0))
                self.media_output=output
                data=dict(kind=key,title=title,value=min(100,max(0,int(value))),muted='muted' in title.lower(),
                          serial=time.monotonic_ns(),output_x=output[0],output_y=output[1],previous=previous,pending=pending)
                path=self.directory/'media.json';temporary=path.with_suffix('.tmp')
                temporary.write_text(json.dumps(data));temporary.chmod(0o600);temporary.replace(path)
                self.spawn('media-osd',[sys.executable,str(Path(__file__).with_name('madway-panel')),'osd','--resident'])
                return True
            except (OSError,ValueError) as error:
                print('madway: media indicator unavailable: '+str(error),file=sys.stderr);return False
        arguments = ["notify-send", "--app-name=madway", "--print-id", f"--expire-time={timeout}", f"--urgency={urgency}",
                     "--hint=boolean:transient:true"]
        if key in self.ids:
            arguments += ["--replace-id", self.ids[key]]
        if value is not None:
            arguments += ["--hint", f"int:value:{min(100, max(0, int(value)))}"]
        try:
            self.ids[key] = run([*arguments, title, body]).strip()
            return True
        except (RuntimeError, FileNotFoundError, subprocess.TimeoutExpired) as error:
            print(f"madway: notification unavailable: {error}", file=sys.stderr)
            return False

    def poll_power(self):
        state=battery_state()
        try:
            with tempfile.NamedTemporaryFile('w',dir=self.directory,delete=False) as output:
                json.dump(state,output);path=Path(output.name)
            path.replace(self.directory/'power.json')
        except OSError as error:
            print(f'madway: battery snapshot unavailable: {error}',file=sys.stderr)
        enabled=self.config.getboolean('power','notifications') and self.config.getboolean('notifications','enabled')
        low=self.config.getint('power','low_percent');critical=self.config.getint('power','critical_percent')
        previous=self.battery_alerts.level
        alert=self.battery_alerts.update(state,low,critical,enabled)
        if alert:
            title=('Battery critical' if alert=='critical' else 'Battery low')+f" · {state['percent']}%"
            body='Battery is discharging. '+('Check your charger or save your work.' if state['on_ac'] else 'Connect power'+(' and save your work.' if alert=='critical' else '.'))
            if not self.notify('battery',title,body,urgency='critical' if alert=='critical' else 'normal',timeout=0 if alert=='critical' else 10000):
                self.battery_alerts.level=previous
        elif self.battery_alerts.level==0 and 'battery' in self.ids:
            identity=self.ids.pop('battery')
            try:
                if self.notification_bus is None:
                    self.notification_bus=self.Gio.bus_get_sync(self.Gio.BusType.SESSION,None)
                def closed(bus,result):
                    try:bus.call_finish(result)
                    except self.GLib.Error as error:
                        print(f'madway: battery notification dismissal unavailable: {error}',file=sys.stderr)
                self.notification_bus.call('org.freedesktop.Notifications','/org/freedesktop/Notifications',
                    'org.freedesktop.Notifications','CloseNotification',self.GLib.Variant('(u)',(int(identity),)),
                    None,self.Gio.DBusCallFlags.NO_AUTO_START,1000,None,closed)
            except (ValueError,self.GLib.Error):pass
        return True

    def wallpaper(self):
        self.background.apply(self.config)

    def apply(self):
        self.config = settings()
        self.wallpaper()
        if self.config.getboolean("notifications", "enabled"):
            anchor = self.config.get("notifications", "anchor")
            if anchor not in {"top-right", "top-left", "bottom-right", "bottom-left"}:
                raise RuntimeError("Unknown notification position")
            timeout = min(15000, max(1000, self.config.getint("notifications", "timeout")))
            width = min(600, max(200, self.config.getint("notifications", "width")))
            options = (anchor, timeout, width, *self.config.items('appearance'),*self.config.items('colors'))
            if options != self.notification_options:
                self.terminate("notifications")
                lines = [line for line in (SHARE / "mako.conf").read_text().splitlines()
                         if line.split("=", 1)[0] not in {"anchor", "width", "default-timeout"}]
                (self.directory / "mako.conf").write_text(theme_style("\n".join(lines), self.config) +
                    f"\nanchor={anchor}\nwidth={width}\ndefault-timeout={timeout}\n")
                self.notification_options = options
            self.spawn("notifications", ["mako", "--config", str(self.directory / "mako.conf")])
        else:
            self.terminate("notifications")
        media_options=(*self.config.items('appearance'),*self.config.items('colors'),*self.config.items('motion'))
        if media_options!=self.media_options:
            self.terminate('media-osd');self.media_options=media_options
        if self.config.getboolean('notifications','enabled') and self.config.getboolean('notifications','indicators'):
            self.spawn('media-osd',[sys.executable,str(Path(__file__).with_name('madway-panel')),'osd','--resident'])
        else:self.terminate('media-osd')
        panel_options = (*self.config.items('appearance'),*self.config.items('colors'), *self.config.items("panel"), *self.config.items("power"))
        if panel_options != self.panel_options:
            self.terminate("panel")
            self.panel_options = panel_options
        if self.config.getboolean("panel", "enabled"):
            self.spawn("panel", [sys.executable, str(Path(__file__).with_name("madway-panel")), "bar"])
        else:
            self.terminate("panel")
        self.dock()
        desktop_options=(*self.config.items('appearance'),*self.config.items('colors'),*self.config.items('desktop'))
        if desktop_options!=self.desktop_options:
            self.terminate('desktop-icons');self.desktop_options=desktop_options
        if self.config.getboolean('desktop','icons'):
            self.spawn('desktop-icons',[sys.executable,str(Path(__file__).with_name('madway-desktop'))])
        else:self.terminate('desktop-icons')
        os.kill(self.parent, signal.SIGHUP)
        self.poll_session_power()

    def compositor(self, command):
        with socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM) as channel:
            channel.sendto(command.encode(), str(self.directory / "compositor.sock"))

    def dock(self):
        options = (*self.config.items('appearance'),*self.config.items('colors'), *self.config.items('dock'))
        if options != self.dock_options:
            self.terminate('dock');self.dock_options = options
        if not self.config.getboolean('dock','enabled'):
            self.terminate('dock');return
        position = self.config.get('dock','position')
        if position not in {'top','bottom','left','right'}:raise ValueError('Unknown dock position')
        size = min(48,max(20,self.config.getint('dock','icon_size')))
        helper = shlex.quote(str(Path(__file__).resolve()))
        config = dict(name='madway-dock',layer='top',position=position,width=2 if position in {'top','bottom'} else size+12,
                      height=size+12 if position in {'top','bottom'} else 2,spacing=min(12,max(0,self.config.getint('dock','spacing'))),exclusive=True,
                      **{'gtk-layer-shell':True,'namespace':'madway-dock','fixed-center':False,'margin':4,
                         'modules-left':['custom/'+key for key in ('apps','terminal','files','settings') if self.config.getboolean('dock','show_'+key)],
                         'modules-center':[],'modules-right':['tray'] if self.config.getboolean('dock','tray') else [],
                         'wlr/taskbar':{'format':'{icon}' if self.config.getboolean('dock','icons_only') else '{icon} {name}',
                                        'icon-size':size,'all-outputs':False,'on-click':'minimize-raise','on-click-middle':'close','on-click-right':'activate',
                                        'tooltip-format':'{title}','app_ids-mapping':{'org.kde.konsole':'org.kde.konsole'}},
                         'tray':{'icon-size':20,'spacing':5,'show-passive-items':True}})
        for key,command,tooltip in [('apps','launcher','Applications'),('terminal','terminal','Konsole'),
                                    ('files','files','Files'),('settings','settings','Settings')]:
            config['custom/'+key]={'format':' ','tooltip-format':tooltip,'on-click':helper+' action '+command}
        self.pin_defs=[];pin_css='';ignored=[]
        pin_directory=self.directory/'dock-pins';pin_directory.mkdir(mode=0o700,exist_ok=True)
        for identity in self.apps['pins'](self.config):
            app=self.apps['resolve'](identity);token='pin'+hashlib.sha256(identity.encode()).hexdigest()[:12]
            self.pin_defs.append((identity,app,token));module='custom/'+token
            arguments=shlex.quote(identity)
            config['modules-center'].append(module)
            config[module]={'exec':'cat '+shlex.quote(str(pin_directory/(token+'.json'))),'return-type':'json','format':'{text}',
                'signal':8,'escape':True,'on-click':helper+' dock-launch '+arguments,'on-click-right':helper+' dock-menu '+arguments}
            if app:
                ignored.extend(self.apps['aliases'](app));icon=app.get_icon()
                image=self.apps['icon_css'](icon,size,self.config.get('appearance','icon_theme').strip())
            else:image='-gtk-icontheme("application-x-executable")'
            pin_css+=f'\n#custom-{token} {{ min-width: {size}px; min-height: {size}px; margin: 1px; padding: 0 2px; background-image: {image}; background-size: {size}px; background-repeat: no-repeat; background-position: center; border-bottom: 2px solid transparent; }}\n'
            pin_css+=f'#custom-{token}.running {{ border-bottom-color: #888888; }} #custom-{token}.active {{ border-bottom-color: #6488f3; }}\n'
        config['wlr/taskbar']['ignore-list']=sorted(set(ignored))
        config['margin']=min(32,max(0,self.config.getint('dock','margin')))
        if self.config.get('appearance','icon_theme').strip():
            config['wlr/taskbar']['icon-theme']=self.config.get('appearance','icon_theme').strip()
        if self.config.getboolean('dock','show_running'):config['modules-center'].append('wlr/taskbar')
        self.poll_pins(signal_update=False)
        (self.directory/'dock.json').write_text(json.dumps(config))
        style=theme_style((SHARE/'dock.css').read_text(),self.config)
        if self.config.get('appearance','icon_theme').strip():
            for key,name in [('apps','view-app-grid-symbolic'),('terminal','utilities-terminal'),('files','system-file-manager'),('settings','preferences-system')]:
                image=self.apps['icon_css'](self.Gio.ThemedIcon.new(name),size,self.config.get('appearance','icon_theme').strip())
                style+=f'\n#custom-{key} {{ background-image: {image}; }}'
        style+=f"\nwindow#waybar > box {{ border-radius: {min(24,max(0,self.config.getint('dock','radius')))}px; }}"
        (self.directory/'dock.css').write_text(style+pin_css)
        self.spawn('dock',['waybar','--config',str(self.directory/'dock.json'),'--style',str(self.directory/'dock.css')])

    def poll_pins(self,signal_update=True):
        try:state=json.loads((self.directory/'desktop.json').read_text())
        except (OSError,ValueError):state={}
        changed=False
        for identity,app,token in self.pin_defs:
            rows=[row for row in state.get('all_windows',state.get('windows',[])) if app and self.apps['matches'](app,row)]
            active=any(row.get('focused') for row in rows)
            payload=json.dumps(dict(text=' ',tooltip=app.get_display_name() if app else identity+' (unavailable)',
                **{'class':['active'] if active else ['running'] if rows else []}))
            path=self.directory/'dock-pins'/(token+'.json')
            if self.pin_payloads.get(token)==payload and path.exists():continue
            try:
                temporary=path.with_suffix('.tmp');temporary.write_text(payload);temporary.chmod(0o600);temporary.replace(path)
                self.pin_payloads[token]=payload;changed=True
            except OSError:pass
        process=self.children.get('dock')
        if changed and signal_update and process and process.poll() is None:
            try:os.kill(process.pid,signal.SIGRTMIN+8)
            except ProcessLookupError:pass
        return True

    def launcher(self, mode):
        existing = self.children.get("launcher")
        if existing is not None and existing.poll() is None:
            self.terminate("launcher")
            return
        if mode=='drun':
            self.spawn('launcher',[sys.executable,str(Path(__file__).with_name('madway-panel')),'spotlight'])
            return
        style = self.directory / "wofi.css"
        style.write_text(overlay_style('wofi.css', self.config))
        geometry=[]
        try:
            state=json.loads((self.directory/'desktop.json').read_text())
            outputs=json.loads((self.directory/'outputs.json').read_text()).get('outputs',[])
            enabled=[row for row in outputs if row.get('enabled')]
            output=next((row for row in enabled if (row.get('x'),row.get('y'))==(state.get('output_x'),state.get('output_y'))),enabled[0] if enabled else None)
            if output:
                width,height=output['width'],output['height']
                if output.get('transform',0)%2:width,height=height,width
                scale=max(.25,float(output.get('scale',1)));width/=scale;height/=scale
                geometry=['--width',str(int(min(max(240,self.config.getint('launcher','width')),max(160,width-40)))),
                          '--lines',str(min(max(1,self.config.getint('launcher','lines')),max(1,int((height-132)//42)))),'--monitor',output['name']]
        except (OSError,ValueError,KeyError,TypeError):pass
        launcher_config=self.directory/'wofi.conf'
        lines=[line for line in (SHARE/'wofi.conf').read_text().splitlines() if not line.startswith(('allow_images=','image_size=','width=','lines='))]
        lines+=['allow_images='+self.config.get('launcher','icons'),'image_size='+str(min(48,max(16,self.config.getint('launcher','icon_size')))),
                'width='+str(min(1000,max(240,self.config.getint('launcher','width')))),'lines='+str(min(12,max(1,self.config.getint('launcher','lines'))))]
        launcher_config.write_text('\n'.join(lines)+'\n')
        self.spawn("launcher", ["wofi", "--show", mode, "--conf", str(launcher_config),*geometry,
                   "--style", str(style), "--term", str(Path(__file__).resolve().with_name("madway-terminal")), "--prompt",
                   "Search applications…" if mode == "drun" else "Run command…"])

    def overlay(self, scene=None):
        existing = self.children.get('demoscene')
        if existing is not None and existing.poll() is None and scene is None:
            self.terminate('demoscene');return
        scene = scene or self.config.get("demoscene", "scene")
        if scene not in demoscenes():raise ValueError("Demoscene unavailable; install your local demoscene package")
        if existing is not None and existing.poll() is None:
            if getattr(self, 'overlay_scene', None) == scene:return
            self.terminate('demoscene')
        candidates = [Path(__file__).resolve().with_name('madway-demoscene'),
                      Path(__file__).resolve().parent.parent/'build-demoscene/extras/demoscene/madway-demoscene',
                      Path(__file__).resolve().parent.parent/'build/extras/demoscene/madway-demoscene']
        binary = next((str(path) for path in candidates if path.is_file() and os.access(path, os.X_OK)), None)
        binary = binary or shutil.which('madway-demoscene')
        if not binary:raise RuntimeError('Build/install the optional overlay with scripts/install-madway --demoscene')
        arguments = [binary, '--scene', scene]
        self.overlay_scene = scene
        assets = self.config.get('demoscene', 'assets').strip()
        if assets:arguments += ['--assets', str(Path(assets).expanduser())]
        if self.config.getboolean('demoscene', 'sound'):arguments += ['--sound']
        if not self.config.getboolean('demoscene', 'click_through'):arguments += ['--interactive']
        self.spawn('demoscene', arguments)

    def perform(self, message):
        name = message.get("action")
        if isinstance(name,str) and name.startswith('application-menu '):
            parts=name.split()
            if len(parts)!=4:raise ValueError('Invalid application menu request')
            message.update(id=int(parts[1]),x=int(parts[2]),y=int(parts[3]));name='application-menu'
        if isinstance(name, str) and name.startswith("desktop-menu "):
            parts = name.split()
            if len(parts) != 3:
                raise RuntimeError("Invalid menu position")
            message.update(x=int(parts[1]), y=int(parts[2]));name = "desktop-menu"
        if name=='application-menu':
            try:state=json.loads((self.directory/'desktop.json').read_text())
            except (OSError,ValueError):state={}
            self.terminate('desktop-menu')
            detail=str(message.get('app_id') or message.get('id',0))
            self.spawn('desktop-menu',[sys.executable,str(Path(__file__).with_name('madway-panel')),'menu','--page','Application',
                '--detail='+detail,'--x',str(int(message.get('x',state.get('pointer_x',0)))),
                '--y',str(int(message.get('y',state.get('pointer_y',0))))])
        elif name in {'dock-pin','dock-unpin','dock-launch'}:
            identity=message.get('app_id','');app=self.apps['resolve'](identity)
            if name=='dock-launch':
                if not app:raise RuntimeError('This application is no longer installed')
                try:state=json.loads((self.directory/'desktop.json').read_text())
                except (OSError,ValueError):state={}
                rows=[row for row in state.get('all_windows',state.get('windows',[])) if self.apps['matches'](app,row)]
                rows.sort(key=lambda row:(not row.get('visible_workspace',False),not row.get('focused',False)))
                if rows and not message.get('new'):self.compositor('activate '+str(rows[0]['id']))
                else:app.launch([],None)
            else:
                config=settings();pinned=self.apps['pins'](config)
                identity=app.get_id() if app else identity
                if name=='dock-pin':
                    if not app:raise RuntimeError('No desktop launcher is registered for this application')
                    if identity not in pinned:pinned.append(identity)
                else:pinned=[value for value in pinned if value!=identity]
                config['dock']['pinned']=json.dumps(pinned);write_settings(config)
                self.config=config;self.dock()
        elif name in {"desktop-menu", "panel-menu"}:
            origin=(message.get('page','Desktop'),message.get('edge','point'),int(message.get('x',0)),int(message.get('y',0)))
            current=self.children.get('desktop-menu')
            if name=='panel-menu' and current and current.poll() is None and self.menu_origin==origin:
                self.terminate('desktop-menu');self.menu_origin=None;return
            self.menu_origin=origin if name=='panel-menu' else None
            if name=='panel-menu':
                try:
                    outputs=json.loads((self.directory/'outputs.json').read_text()).get('outputs',[])
                    for output in outputs:
                        width,height=output['width'],output['height']
                        if output.get('transform',0)%2:width,height=height,width
                        scale=output.get('scale',1)
                        if output.get('enabled') and output['x']<=message.get('x',0)<output['x']+width/scale and output['y']<=message.get('y',0)<=output['y']+height/scale:
                            self.compositor('output '+output['name']);break
                except (OSError,ValueError,KeyError,TypeError):pass
            page = message.get("page", "Desktop")
            if page not in {"Desktop", "Settings", "Window", "Workspaces", "Audio", "Status", "Clock", "Session", "Demoscenes", "Battery", "Screenshot", "Application"}:
                raise RuntimeError("Unknown panel menu")
            self.terminate("desktop-menu")
            edge = message.get("edge", "point")
            if edge not in {"point", "top", "bottom", "left", "right"}:raise ValueError("Unknown panel edge")
            self.spawn("desktop-menu", [sys.executable, str(Path(__file__).with_name("madway-panel")), "menu",
                "--x", str(int(message.get("x", 0))), "--y", str(int(message.get("y", 0))),
                "--edge", edge, "--page", page, "--detail="+str(message.get("detail", ""))[:256]])
        elif name == "power-refresh":
            self.poll_power()
        elif name == "overlay-start":
            self.overlay(str(message.get("scene", "")))
        elif name == "overlay-toggle":
            self.overlay()
        elif name == "overlay-stop":
            self.terminate("demoscene")
        elif name == "switcher-show":
            self.spawn("switcher", [sys.executable, str(Path(__file__).with_name("madway-panel")), "switcher"])
        elif name == "switcher-hide":
            self.terminate("switcher")
        elif name == "switcher-select":
            self.compositor("focus "+str(int(message["id"])))
            self.terminate("switcher")
        elif name == 'taskbar-toggle':
            self.terminate('desktop-menu');self.menu_origin=None
            self.compositor('toggle-task '+str(int(message['id'])))
        elif name == "tile":
            direction = message.get("direction")
            if direction not in {"left", "right", "up", "down", "master"}:raise RuntimeError("Unknown tile direction")
            self.compositor("tile "+direction)
        elif name == 'tile-swap':
            self.compositor('swap-tile '+str(int(message['id'])))
        elif name == 'window-preview':
            self.compositor('preview '+str(int(message['id'])))
        elif name == "script-config":
            updates = message.get("updates", {})
            validate_script_updates(updates)
            config = settings()
            for field, value in updates.items():
                section, key = field.split('.', 1)
                config[section][key] = str(value)
            write_settings(config)
            self.apply()
        elif name == 'desktop-preset':
            write_settings(desktop_preset(settings(), message.get('preset')))
            self.apply()
        elif name == 'toggle-panel':
            config=settings()
            config['panel']['enabled']=str(not config.getboolean('panel','enabled')).lower()
            write_settings(config)
            self.terminate('desktop-menu');self.menu_origin=None
            self.apply()
        elif name == 'toggle-desktop-icons':
            config=settings()
            config['desktop']['icons']=str(not config.getboolean('desktop','icons')).lower()
            write_settings(config)
            self.terminate('desktop-menu')
            self.apply()
        elif name == "audio-control":
            audio_control(message)
        elif name == "launch-app":
            from gi.repository import Gio
            app = Gio.DesktopAppInfo.new(str(message["id"]))
            if app is None or not app.should_show():raise RuntimeError("Application unavailable")
            app.launch([], None)
        elif name == "close-menu":
            self.terminate("desktop-menu")
            self.menu_origin=None
        elif name == "move-workspace":
            value = int(message['value'])
            if not 0 <= value < 9:raise ValueError('Invalid workspace')
            self.compositor(f'move-workspace {value}')
        elif name == "workspace":
            value = int(message["value"])
            if not 0 <= value < 9:raise RuntimeError("Invalid workspace")
            self.compositor(f"workspace {value}")
        elif name in {"window-floating", "window-maximize", "window-minimize", "window-fullscreen", "window-close", "window-above"}:
            if message.get('id'):self.compositor('activate '+str(int(message['id'])))
            self.compositor(name.removeprefix("window-"))
        elif name == "terminal":
            process = subprocess.Popen(["konsole", "--separate", "--platform", "wayland"], start_new_session=True)
            self.children[f"terminal-{process.pid}"] = process
        elif name == 'files':
            from gi.repository import Gio
            Gio.AppInfo.launch_default_for_uri(Path.home().as_uri(), None)
        elif name=='wallpaper-next':
            self.background.next()
        elif name in {'screenshot','screenshot-region','screenshot-clipboard'}:
            arguments=[sys.executable,str(Path(__file__).with_name('madway-screenshot'))]
            if name=='screenshot-region':arguments.append('--region')
            if name=='screenshot-clipboard':arguments.append('--clipboard')
            self.spawn('screenshot',arguments)
        elif name in {"launcher", "run"}:
            self.launcher("drun" if name == "launcher" else "run")
        elif name in {"settings", "settings-page"}:
            page = message.get("page", "Windows")
            if page not in SETTINGS_PAGES:
                raise RuntimeError("Unknown settings page")
            process = self.spawn("settings", [sys.executable, str(Path(__file__).resolve()), "settings", "--page", page])
            if process is not None:
                attempts = 0
                def select_page():
                    nonlocal attempts
                    attempts += 1
                    try:
                        with socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM) as channel:
                            channel.sendto(page.encode(), str(self.directory / f"settings-{process.pid}.sock"))
                        self.compositor("focus-settings")
                        return False
                    except OSError:
                        return process.poll() is None and attempts < 10
                self.GLib.timeout_add(100, select_page)
            self.compositor("focus-settings")
        elif name == "apply":
            self.apply()
            self.notify("settings", "Settings applied")
        elif name in {'volume-up','volume-down','volume-mute','set-volume','brightness-up','brightness-down','set-brightness'}:
            self.media.request(name,message)
        elif name in {"startup-sound", "logon-sound", "logout-sound", "shutdown-sound"}:
            event = name.removesuffix("-sound")
            if not self.config.getboolean("sounds", "enabled"):
                raise RuntimeError("Enable Session sounds in settings first")
            configured = self.config.get("sounds", event).strip()
            if not configured or not Path(configured).expanduser().is_file():
                raise RuntimeError(f"Choose an existing {event} sound file in settings")
            self.sound(event)
        elif name in {'logout','poweroff','reboot'}:
            self.session_exit.begin(name)
        elif name == 'session-effect-started':
            self.session_exit.started(message.get('token',''))
        elif name == 'session-opening-started':
            self.session_exit.opening_started(message.get('token',''))
        elif name == 'session-exit-ready':
            self.session_exit.ready(message.get('token',''))
        elif name == 'session-effect-preview':
            self.session_exit.preview(str(message.get('mode','fade')),str(message.get('shader','crt')),int(message.get('duration',600)),bool(message.get('opening',False)))
        elif name == 'session-confirm':
            operation=message.get('operation')
            if operation not in {'poweroff','reboot','logout'}:raise ValueError('Unknown session operation')
            self.spawn('session-confirm',[sys.executable,str(Path(__file__).resolve()),'confirm-session',operation])
        elif name == 'sleep':
            self.power.request_sleep()
        elif name == 'lock':
            self.locker.retry()
        else:
            raise RuntimeError("Unknown desktop action")

    def finish_session_operation(self,operation):
        if operation=='logout':
            os.kill(self.parent,signal.SIGTERM);return
        self.shutdown_played=True
        try:run(['systemctl',operation])
        except Exception:
            self.shutdown_played=False;raise

    def receive(self, source, condition):
        del source, condition
        try:
            payload = json.loads(self.channel.recv(8192))
            if not isinstance(payload, dict):
                raise ValueError("Invalid action")
            self.perform(payload)
        except Exception as error:
            print(f"madway: desktop action failed: {error}", file=sys.stderr)
            self.notify("error", "Desktop action unavailable", str(error))
        return True

    def prepare_shutdown(self, connection, sender, path, interface, member, parameters):
        del connection, sender, path, interface, member
        if parameters.unpack()[0]:
            self.exit_event = "shutdown"
            if not self.shutdown_played:
                self.sound("shutdown")
                self.shutdown_played = True

    def stop(self):
        self.loop.quit()
        return False

    def serve(self):
        # User scripts placed here become available in the run launcher.
        os.environ["PATH"] = str(Path.home() / ".local" / "bin") + ":" + os.environ.get("PATH", "")
        os.environ.setdefault("GIO_USE_VFS", "local")
        try:
            if os.environ.get("MADWAY_NATIVE") == "1" and shutil.which("dbus-update-activation-environment"):
                try:
                    run(["dbus-update-activation-environment", "--systemd", "WAYLAND_DISPLAY", "XDG_CURRENT_DESKTOP", "XDG_SESSION_TYPE"])
                except (RuntimeError, subprocess.TimeoutExpired) as error:
                    print(f"madway: session activation environment: {error}", file=sys.stderr)
            self.apply()
            self.poll_power()
            login_event=runpy.run_path(str(Path(__file__).with_name('madway_sound.py')))['login_event']
            event=login_event(os.environ.get('MADWAY_NATIVE')=='1')
            self.session_exit.opening(event)
            print(f"madway: desktop services ready on {self.socket_path}", flush=True)
            startup = CONFIG.parent / 'startup.madway'
            if startup.is_file():
                self.spawn('startup-script', [sys.executable, str(Path(__file__).with_name('madway-script')), str(startup)])
            self.loop.run()
        finally:
            # Completed exit sound is already synchronized with the visual.
            exit_audio_done=self.exit_sound_played
            self.session_exit.close()
            self.media.close()
            self.power.close()
            self.locker.close()
            self.background.close()
            if not exit_audio_done and not self.shutdown_played:
                self.sound(self.exit_event, wait=True)
            for key in list(self.children):
                self.terminate(key)
            self.channel.close()
            self.socket_path.unlink(missing_ok=True)
            (self.directory / "mako.conf").unlink(missing_ok=True)
            (self.directory / "wofi.css").unlink(missing_ok=True)
            (self.directory / "power.json").unlink(missing_ok=True)
            (self.directory / 'media.json').unlink(missing_ok=True)
            for path in self.directory.glob("settings-*.sock"):path.unlink(missing_ok=True)
            try:
                self.directory.rmdir()
            except OSError:
                pass


def session_confirmation(operation,parent=None):
    import gi
    gi.require_version('Gtk','3.0')
    from gi.repository import GLib
    if parent is None:GLib.set_prgname('org.madway.Session')
    module=runpy.run_path(str(Path(__file__).with_name('madway_widgets.py')))
    dialog=module['SessionConfirmation'](operation,dict(runtime_directory=runtime_directory,overlay_style=overlay_style),parent)
    if dialog.run():action(operation)


def settings_window(initial_page="Windows"):
    import gi
    gi.require_version("Gtk", "3.0")
    from gi.repository import Gtk, Gdk, GLib
    Gtk.Settings.get_default().set_property("gtk-enable-animations", False)
    GLib.set_prgname("org.madway.Settings")
    config = settings()
    icon_theme(config)
    if 'madway_settings' not in sys.modules:
        spec=importlib.util.spec_from_file_location('madway_settings',Path(__file__).with_name('madway_settings.py'))
        module=importlib.util.module_from_spec(spec);sys.modules[spec.name]=module;spec.loader.exec_module(module)
    editors=vars(sys.modules['madway_settings'])
    window = Gtk.Window(title="madway — Settings")
    # This owned client requests no CSD; madway supplies its compact 14px frame.
    window.set_decorated(False)
    display=Gdk.Display.get_default()
    monitor=display.get_monitor_at_point(0,0) if display else None
    bounds=monitor.get_geometry() if monitor else None
    window.set_default_size(min(760,max(540,bounds.width-48)) if bounds else 760,
                            min(540,max(360,bounds.height-80)) if bounds else 540)
    window.get_style_context().add_class('settings-window')
    window.connect("destroy", Gtk.main_quit)
    provider = Gtk.CssProvider()
    settings_css = "* { font-family: monospace; font-size: 11px; border-radius: 0; } window { background: #000000; color: #c8c8c8; } button, entry, spinbutton, combobox { min-height: 16px; padding: 1px 4px; background: #080808; color: #c8c8c8; border: 1px solid #282828; box-shadow: none; } button:hover, button:focus { border-color: #666666; } spinbutton button { min-height: 14px; padding: 0 3px; border: 0; } stacksidebar { background: #080808; } stacksidebar row { min-height: 18px; padding: 2px 4px; } stacksidebar row, stacksidebar row label { color: #bdbdbd; } stacksidebar row:hover, stacksidebar row:selected { background: #222222; } label { color: #c8c8c8; padding: 0; } scale { padding: 2px; } scale trough { min-height: 2px; background: #282828; } scale highlight { background: #888888; }"
    # Apply layout rules after theme material rules, consistently across profiles.
    def settings_styles():
        colors=palette(config)
        layout=(SHARE/'settings.css').read_text()
        for name,value in colors.items():layout=layout.replace('@'+name+'@',value)
        layout=layout.replace('@selection_text@',contrast_text(colors['active']))
        return (theme_style(settings_css,config)+layout+font_style(config)).encode()
    provider.load_from_data(settings_styles())
    Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
    root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL,spacing=0)
    window.add(root)
    content=Gtk.Box(spacing=0);root.pack_start(content,True,True,0)
    navigation=Gtk.Box(orientation=Gtk.Orientation.VERTICAL,spacing=8,margin=8)
    navigation.set_size_request(178,-1);navigation.get_style_context().add_class('settings-navigation')
    content.pack_start(navigation,False,False,0)
    search=Gtk.SearchEntry(placeholder_text='Find settings…');search.set_width_chars(18);navigation.pack_start(search,False,False,0)
    sidebar=Gtk.ScrolledWindow();sidebar.set_policy(Gtk.PolicyType.NEVER,Gtk.PolicyType.AUTOMATIC);sidebar.set_overlay_scrolling(False)
    navigation.pack_start(sidebar,True,True,0)
    stack=Gtk.Stack();stack.set_hexpand(True);tabs=None
    body=Gtk.Box(orientation=Gtk.Orientation.VERTICAL,spacing=4,margin=12)
    content.pack_start(body,True,True,0)
    heading=Gtk.Label(xalign=0);heading.get_style_context().add_class('settings-heading');body.pack_start(heading,False,False,0)
    description=Gtk.Label(xalign=0,wrap=True,max_width_chars=65);description.get_style_context().add_class('settings-description');body.pack_start(description,False,False,0)
    body.pack_start(stack,True,True,0)
    status=Gtk.Label(xalign=0,wrap=True,max_width_chars=80);status.get_style_context().add_class('settings-status');status.set_no_show_all(True)
    root.pack_start(status,False,False,0)
    status.connect('notify::label',lambda widget,*args:widget.set_visible(bool(widget.get_text())))

    def category(name):
        grid=Gtk.Grid(column_spacing=12,row_spacing=9,margin_top=8,margin_bottom=8)
        grid.set_valign(Gtk.Align.START);grid.set_hexpand(True);grid.next_row=0
        scroll=Gtk.ScrolledWindow();scroll.set_policy(Gtk.PolicyType.NEVER,Gtk.PolicyType.AUTOMATIC)
        scroll.set_overlay_scrolling(False);scroll.add(grid)
        stack.add_titled(scroll,name,'Themes & style' if name=='Appearance' else 'Desktop icons' if name=='Desktop' else name)
        return grid

    def section(grid,title):
        label=Gtk.Label(label=title,xalign=0);label.get_style_context().add_class('settings-section')
        grid.attach(label,0,grid.next_row,2,1);grid.next_row+=1

    def field(grid,label,widget):
        row=getattr(grid,'next_row',len(grid.get_children())//2);grid.next_row=row+1
        if not label and isinstance(widget,(Gtk.Box,Gtk.Expander)):
            widget.set_hexpand(True);grid.attach(widget,0,row,2,1);return widget
        caption=Gtk.Label(label=label,xalign=0,wrap=True,max_width_chars=23)
        caption.set_width_chars(17);caption.set_valign(Gtk.Align.CENTER)
        grid.attach(caption,0,row,1,1)
        widget.set_hexpand(True);widget.set_valign(Gtk.Align.CENTER)
        if isinstance(widget,Gtk.Scale):widget.set_value_pos(Gtk.PositionType.RIGHT)
        if isinstance(widget,Gtk.Label):widget.set_max_width_chars(36);widget.set_line_wrap(True)
        grid.attach(widget,1,row,1,1)
        return widget

    def spin(grid, label, section, key, lower, upper):
        widget = field(grid, label, Gtk.SpinButton.new_with_range(lower, upper, 1))
        widget.set_value(config.getint(section, key))
        widget.set_width_chars(7);widget.set_halign(Gtk.Align.END)
        return widget

    def combo(grid, label, values, selected):
        widget = Gtk.ComboBoxText()
        for key, text in values:
            widget.append(key, text)
        for renderer in widget.get_cells():
            if isinstance(renderer,Gtk.CellRendererText):renderer.set_property('ellipsize',3);renderer.set_property('max-width-chars',26)
        widget.set_active_id(selected)
        return field(grid, label, widget)

    def switch(grid, label, section, key):
        widget = field(grid, label, Gtk.Switch())
        widget.set_active(config.getboolean(section, key))
        widget.set_halign(Gtk.Align.END);widget.set_size_request(44,22)
        return widget

    def file_field(grid, label, value, directory=False):
        controls = Gtk.Box(spacing=5)
        entry = Gtk.Entry(text=value)
        entry.set_width_chars(18)
        controls.pack_start(entry, True, True, 0)
        browse = Gtk.Button(label="Browse…");browse.set_size_request(74,-1)
        def choose(button):
            dialog = Gtk.FileChooserDialog(title="Choose " + label.lower(), transient_for=window,
                    action=Gtk.FileChooserAction.SELECT_FOLDER if directory else Gtk.FileChooserAction.OPEN)
            dialog.add_buttons("Cancel", Gtk.ResponseType.CANCEL, "Open", Gtk.ResponseType.OK)
            if dialog.run() == Gtk.ResponseType.OK:
                entry.set_text(dialog.get_filename())
            dialog.destroy()
        browse.connect("clicked", choose)
        controls.pack_end(browse, False, False, 0)
        field(grid, label, controls)
        return entry

    def send(name, **values):
        try:
            action(name, **values)
            status.set_text("")
        except Exception as error:
            status.set_text(str(error))
        return False

    windows = category("Windows")
    default_mode = combo(windows, "New windows", [("floating", "Floating"), ("tiled", "Master / stack tiles")],
                         config.get("windows", "default_mode"))
    default_mode.set_tooltip_text("Applies to new windows; existing windows keep their mode")
    title = spin(windows, "Title height (px)", "appearance", "title_height", 12, 24)
    gap = spin(windows, "Tile gaps (px)", "appearance", "tile_gap", 0, 12)
    master = spin(windows, "Master width (%)", "windows", "master_percent", 25, 75)
    master.set_tooltip_text("Default for outputs; dragging a tile divider overrides that output for this session. Changing this value resets width overrides.")
    floating_hint = field(windows, "Floating / tiling", Gtk.Label(xalign=0))

    displays = category("Displays")
    display_rows = []
    def read_outputs():
        return json.loads((runtime_directory() / "outputs.json").read_text())
    def load_displays(button=None):
        displays.next_row=0
        display_message=Gtk.Label(xalign=0,wrap=True)
        for child in displays.get_children():
            child.destroy()
        display_rows.clear()
        refresh = Gtk.Button(label="Refresh connected monitors")
        refresh.connect("clicked", load_displays)
        field(displays, "Monitor list", refresh)
        preview=editors['DisplayLayout'](display_rows,lambda:palette(config))
        layout_box=Gtk.Box(orientation=Gtk.Orientation.VERTICAL,spacing=5);layout_box.pack_start(preview,True,True,0)
        arrange=Gtk.Box(spacing=4)
        for label,vertical in [('Arrange horizontally',False),('Arrange vertically',True)]:
            button=Gtk.Button(label=label);button.connect('clicked',lambda widget,vertical=vertical:preview.arrange(vertical));arrange.pack_start(button,True,True,0)
        layout_box.pack_start(arrange,False,False,0)
        hint=Gtk.Label(label='Drag monitors to position them. Edges snap together; Apply saves the layout.',wrap=True,xalign=0)
        layout_box.pack_start(hint,False,False,0);field(displays,'Monitor layout',layout_box)
        try:
            snapshot = read_outputs()
            display_message.set_text(snapshot.get("error", ""))
            for output in snapshot["outputs"]:
                controls = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=3)
                grid = Gtk.Grid(column_spacing=6, row_spacing=4)
                controls.pack_start(Gtk.Label(label=output.get("description") or output["name"], xalign=0, wrap=True), False, False, 0)
                controls.pack_start(grid, False, False, 0)
                enabled = field(grid, "Enabled", Gtk.Switch())
                enabled.set_active(output["enabled"]);enabled.set_halign(Gtk.Align.START)
                options = [("preferred", "Preferred")]
                seen = {"preferred"}
                for mode in [dict(width=output["width"], height=output["height"], refresh=output["refresh"]), *output["modes"]]:
                    key = f"{mode['width']}x{mode['height']}@{mode['refresh']}"
                    if key not in seen:
                        options.append((key, f"{mode['width']} × {mode['height']} / {mode['refresh'] / 1000:g} Hz"))
                        seen.add(key)
                selected = f"{output['width']}x{output['height']}@{output['refresh']}"
                resolution = combo(grid, "Resolution / refresh", options, selected)
                positions = []
                for label, value in [("X position", output["x"]), ("Y position", output["y"])]:
                    control = field(grid, label, Gtk.SpinButton.new_with_range(-32768, 32768, 1))
                    control.set_value(value);positions.append(control)
                scale = field(grid, "Scale", Gtk.SpinButton.new_with_range(.5, 4, .25))
                scale.set_digits(2);scale.set_value(output["scale"])
                rotation = combo(grid, "Rotation", [(str(i), text) for i, text in enumerate(
                    ["Normal", "90°", "180°", "270°", "Flipped", "Flipped 90°", "Flipped 180°", "Flipped 270°"])], str(output["transform"]))
                expander=Gtk.Expander(label=str(len(display_rows)+1)+' · '+output['name']);expander.add(controls);expander.set_expanded(not display_rows)
                field(displays,'',expander)
                row = dict(name=output["name"], enabled=enabled, mode=resolution, x=positions[0], y=positions[1], scale=scale, transform=rotation,pixels=(output['width'],output['height']))
                row["original"] = display_values(row)
                display_rows.append(row)
                for control in (positions[0],positions[1],scale):control.connect('value-changed',lambda widget:preview.queue_draw())
                for control in (resolution,rotation):control.connect('changed',lambda widget:preview.queue_draw())
                enabled.connect('notify::active',lambda *args:preview.queue_draw())
            if not snapshot["outputs"]:
                display_message.set_text("No connected outputs reported")
        except (OSError, ValueError, KeyError) as error:
            display_message.set_text("Monitor information unavailable: " + str(error))
        field(displays, "Status", display_message)
        displays.show_all()
    def display_values(row):
        return dict(enabled=str(row["enabled"].get_active()).lower(), mode=row["mode"].get_active_id(),
                    x=str(row["x"].get_value_as_int()), y=str(row["y"].get_value_as_int()),
                    scale=str(row["scale"].get_value()), transform=row["transform"].get_active_id())
    load_displays()

    appearance = category("Appearance")
    section(appearance,'Desktop profile')
    profiles = themes()
    theme_choice = combo(appearance, "Theme profile", [(key, profiles[key]["name"]) for key in profiles.sections()], config.get("appearance", "theme"))
    presets=Gtk.Box(spacing=6,homogeneous=True)
    for profile,label in [('argent','Argent Silver'),('argent-dark','Argent Midnight')]:
        preset=Gtk.Button(label=label);preset.connect('clicked',lambda w,profile=profile:(action('desktop-preset',preset=profile),window.destroy()))
        presets.pack_start(preset,True,True,0)
    field(appearance,'Coordinated preset',presets)
    section(appearance,'Typography & icons')
    shell_font=field(appearance,'UI font family',Gtk.Entry(text=config.get('appearance','font')))
    shell_font.set_placeholder_text('Theme default (for example Inter or monospace)')
    shell_text_size=spin(appearance,'UI text size (0 = theme)','appearance','text_size',0,20)
    title_text_size=spin(appearance,'Title text size (0 = theme)','appearance','title_font_size',0,18)
    icons_theme=field(appearance,'Icon theme',Gtk.Entry(text=config.get('appearance','icon_theme')))
    icons_theme.set_placeholder_text('System default; or an installed theme name')
    section(appearance,'Color palette')
    custom_colors=switch(appearance,'Override theme colors','appearance','custom_colors')
    color_entries={}
    for key in ('background','surface','text','muted','border','accent','active'):
        line=Gtk.Box(spacing=4);entry=Gtk.Entry(text=config.get('colors',key));entry.set_width_chars(9)
        entry.set_placeholder_text(profiles[config.get('appearance','theme')].get(key,'#000000'))
        line.pack_start(entry,True,True,0);choose=Gtk.ColorButton()
        rgba=Gdk.RGBA();rgba.parse(entry.get_text() or entry.get_placeholder_text());choose.set_rgba(rgba)
        def picked(widget,entry=entry):
            rgba=widget.get_rgba();entry.set_text('#'+''.join(f'{round(value*255):02x}' for value in (rgba.red,rgba.green,rgba.blue)))
        choose.connect('color-set',picked);line.pack_start(choose,False,False,0)
        field(appearance,key.capitalize()+' color',line);color_entries[key]=entry
    reset_colors=Gtk.Button(label='Use profile colors')
    def reset_palette(widget):
        custom_colors.set_active(False)
        for entry in color_entries.values():entry.set_text('')
    reset_colors.connect('clicked',reset_palette);field(appearance,'Colors',reset_colors)
    animations=category("Animations")
    section(animations,'Workspace switching')
    workspace_animate=switch(animations,'Animate workspace switching','workspaces','animate')
    workspace_duration=spin(animations,'Workspace animation (ms)','workspaces','animation_ms',80,500)
    section(animations,'Window actions')
    window_animate=switch(animations,'Animate maximize / minimize','windows','animate')
    window_duration=spin(animations,'Window animation (ms)','windows','animation_ms',80,500)
    close_animate=switch(animations,'Animate closing windows','windows','close_animate')
    close_duration=spin(animations,'Close animation (ms)','windows','close_ms',80,500)
    section(animations,'Desktop surfaces')
    effects=switch(animations,'Desktop effects','motion','effects')
    wallpaper_fade=spin(animations,'Wallpaper fade (ms)','motion','wallpaper_fade_ms',100,2000)
    launcher_duration=spin(animations,'Launcher animation (ms)','motion','launcher_ms',80,600)
    media_duration=spin(animations,'Media indicator animation (ms)','motion','media_ms',80,600)
    exit_page=category('Session effects')
    section(exit_page,'Logout, restart & shutdown')
    exit_mode=combo(exit_page,'Exit animation',[('none','Off'),('fade','Simple fade'),('shader','Custom shader')],config.get('session_effects','mode'))
    exit_shader=combo(exit_page,'Shader style',list(runpy.run_path(str(Path(__file__).with_name('madway_exit.py')))['SHADERS'].items()),config.get('session_effects','shader'))
    exit_duration=spin(exit_page,'Duration (ms)','session_effects','duration_ms',160,1600)
    opening_animation=switch(exit_page,'Animate session opening','session_effects','opening')
    opening_duration=spin(exit_page,'Opening duration (ms)','session_effects','opening_ms',160,1600)
    opening_preview=Gtk.Button(label='Preview opening')
