#!/usr/bin/env python3
"""Madway desktop services and settings. External commands always use argv lists."""

import argparse
import configparser
import json
import os
from pathlib import Path
import re
import shutil
import signal
import socket
import subprocess
import sys
import tempfile

SHARE = Path(__file__).resolve().parent.parent / "share" / "madway"
SETTINGS_PAGES = ("Windows", "Displays", "Appearance", "Input", "Notifications", "Audio & brightness", "Session", "Panel")
CONFIG = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "madway" / "settings.ini"
DEFAULTS = {
    "appearance": {"title_height": "16", "tile_gap": "2"},
    "windows": {"default_mode": "floating", "master_percent": "50"},
    "input": {"modifier": "alt", "repeat_rate": "25", "repeat_delay": "600"},
    "panel": {"enabled": "true", "height": "24", "metrics": "true", "clock": "true"},
    "controls": {"volume_step": "5", "brightness_step": "5"},
    "wallpaper": {"path": "", "mode": "fill", "color": "#121418"},
    "notifications": {"enabled": "true", "indicators": "true", "timeout": "5000", "width": "300", "anchor": "top-right"},
    "sounds": {"enabled": "false", "volume": "0.25", "startup": "", "logout": "", "shutdown": ""},
}


def settings():
    config = configparser.ConfigParser(interpolation=None)
    config.read_dict(DEFAULTS)
    config.read(CONFIG)
    return config


def runtime_directory():
    display = os.environ.get("WAYLAND_DISPLAY", "")
    if not display or "/" in display:
        raise RuntimeError("WAYLAND_DISPLAY must name a running madway socket")
    return Path(os.environ["XDG_RUNTIME_DIR"]) / ("madway-" + display)


def action(name, **values):
    with socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM) as channel:
        channel.sendto(json.dumps({"action": name, **values}).encode(), str(runtime_directory() / "control.sock"))


def run(arguments):
    result = subprocess.run(arguments, capture_output=True, text=True, timeout=4)
    if result.returncode:
        raise RuntimeError(result.stderr.strip() or f"{arguments[0]} failed")
    return result.stdout.strip()


def volume():
    text = run(["wpctl", "get-volume", "@DEFAULT_AUDIO_SINK@"])
    match = re.search(r"Volume:\s*([0-9.]+)", text)
    if not match:
        raise RuntimeError("No default audio output")
    return round(float(match[1]) * 100), "MUTED" in text


def backlight():
    devices = sorted(Path("/sys/class/backlight").glob("*"))
    if not devices:
        return None
    device = devices[0]
    return device, int((device / "brightness").read_text()), int((device / "max_brightness").read_text())


def brightness():
    if shutil.which("brightnessctl"):
        current = int(run(["brightnessctl", "get"]))
        maximum = int(run(["brightnessctl", "max"]))
    else:
        hardware = backlight()
        if hardware is None:
            return None
        _, current, maximum = hardware
    return round(100 * current / maximum) if maximum else None


def set_brightness(percent):
    percent = min(100, max(1, int(percent)))
    if shutil.which("brightnessctl"):
        run(["brightnessctl", "set", f"{percent}%"])
        return
    hardware = backlight()
    if hardware is None:
        raise RuntimeError("No backlight device available")
    device, _, maximum = hardware
    value = max(1, round(maximum * percent / 100))
    # logind checks the caller's session/device access; no sudo or permission changes.
    run(["busctl", "--system", "call", "org.freedesktop.login1",
         "/org/freedesktop/login1/session/auto", "org.freedesktop.login1.Session",
         "SetBrightness", "ssu", "backlight", device.name, str(value)])


class Desktop:
    def __init__(self, compositor_pid):
        import gi
        from gi.repository import Gio, GLib, GLibUnix
        self.Gio, self.GLib = Gio, GLib
        self.parent = compositor_pid
        self.directory = runtime_directory()
        self.directory.mkdir(mode=0o700, parents=True, exist_ok=True)
        self.channel = socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM)
        self.socket_path = self.directory / "control.sock"
        if self.socket_path.exists():
            raise RuntimeError("A desktop helper already owns this display")
        self.channel.bind(str(self.socket_path))
        self.channel.setblocking(False)
        self.loop = GLib.MainLoop()
        self.children = {}
        self.ids = {}
        self.notification_options = None
        self.panel_options = None
        self.settings_page = "Windows"
        self.exit_event = "logout"
        self.shutdown_played = False
        self.config = settings()
        GLib.io_add_watch(self.channel.fileno(), GLib.IO_IN, self.receive)
        GLibUnix.signal_add(GLib.PRIORITY_DEFAULT, signal.SIGTERM, self.stop)
        GLibUnix.signal_add(GLib.PRIORITY_DEFAULT, signal.SIGINT, self.stop)
        GLib.timeout_add_seconds(1, self.reap)
        try:
            self.system_bus = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
            self.system_bus.signal_subscribe("org.freedesktop.login1", "org.freedesktop.login1.Manager",
                "PrepareForShutdown", "/org/freedesktop/login1", None, Gio.DBusSignalFlags.NONE,
                self.prepare_shutdown)
        except GLib.Error:
            self.system_bus = None

    def spawn(self, key, arguments):
        existing = self.children.get(key)
        if existing is not None and existing.poll() is None:
            return existing
        try:
            process = subprocess.Popen(arguments)
        except FileNotFoundError:
            print(f"madway: optional desktop program missing: {arguments[0]}", file=sys.stderr)
            return None
        self.children[key] = process
        return process

    def terminate(self, key):
        process = self.children.pop(key, None)
        if process is not None and process.poll() is None:
            process.terminate()
            try:
                process.wait(timeout=1)
            except subprocess.TimeoutExpired:
                process.kill()
                process.wait()

    def reap(self):
        for key, process in list(self.children.items()):
            if process.poll() is not None:
                if process.returncode:
                    print(f"madway: {key} exited with status {process.returncode}", file=sys.stderr)
                del self.children[key]
        return True

    def sound(self, event, wait=False):
        if not self.config.getboolean("sounds", "enabled"):
            return
        configured = self.config.get("sounds", event).strip()
        if not configured:
            return
        path = Path(configured).expanduser()
        if not path.is_file():
            return
        gain = min(1, max(0, self.config.getfloat("sounds", "volume")))
        if shutil.which("pw-play"):
            arguments = ["pw-play", "--volume", str(gain), str(path)]
        elif shutil.which("paplay"):
            arguments = ["paplay", "--volume", str(round(gain * 65536)), str(path)]
        else:
            return
        process = self.spawn("sound-" + event, arguments)
        if wait and process is not None:
            try:
                process.wait(timeout=8)
            except subprocess.TimeoutExpired:
                self.terminate("sound-" + event)

    def notify(self, key, title, body="", value=None):
        if not self.config.getboolean("notifications", "enabled"):
            return
        if key in {"volume", "brightness"} and not self.config.getboolean("notifications", "indicators"):
            return
        arguments = ["notify-send", "--app-name=madway", "--print-id", "--expire-time=1500",
                     "--hint=boolean:transient:true"]
        if key in self.ids:
            arguments += ["--replace-id", self.ids[key]]
        if value is not None:
            arguments += ["--hint", f"int:value:{min(100, max(0, int(value)))}"]
        try:
            self.ids[key] = run([*arguments, title, body]).strip()
        except (RuntimeError, FileNotFoundError, subprocess.TimeoutExpired) as error:
            print(f"madway: notification unavailable: {error}", file=sys.stderr)

    def wallpaper(self):
        image = self.config.get("wallpaper", "path").strip()
        color = self.config.get("wallpaper", "color")
        mode = self.config.get("wallpaper", "mode")
        if not re.fullmatch(r"#[0-9a-fA-F]{6}", color):
            raise RuntimeError("Wallpaper color must be #RRGGBB")
        if mode not in {"fill", "fit", "center", "stretch", "tile"}:
            raise RuntimeError("Unknown wallpaper mode")
        arguments = ["swaybg", "-c", color[1:]]
        if image:
            path = Path(image).expanduser()
            if not path.is_file():
                raise RuntimeError("Wallpaper image does not exist")
            arguments += ["-i", str(path), "-m", mode]
        self.terminate("wallpaper")
        self.spawn("wallpaper", arguments)

    def apply(self):
        self.config = settings()
        self.wallpaper()
        if self.config.getboolean("notifications", "enabled"):
            anchor = self.config.get("notifications", "anchor")
            if anchor not in {"top-right", "top-left", "bottom-right", "bottom-left"}:
                raise RuntimeError("Unknown notification position")
            timeout = min(15000, max(1000, self.config.getint("notifications", "timeout")))
            width = min(600, max(200, self.config.getint("notifications", "width")))
            options = (anchor, timeout, width)
            if options != self.notification_options:
                self.terminate("notifications")
                lines = [line for line in (SHARE / "mako.conf").read_text().splitlines()
                         if line.split("=", 1)[0] not in {"anchor", "width", "default-timeout"}]
                (self.directory / "mako.conf").write_text("\n".join(lines) +
                    f"\nanchor={anchor}\nwidth={width}\ndefault-timeout={timeout}\n")
                self.notification_options = options
            self.spawn("notifications", ["mako", "--config", str(self.directory / "mako.conf")])
        else:
            self.terminate("notifications")
        panel_options = tuple(self.config.items("panel"))
        if panel_options != self.panel_options:
            self.terminate("panel")
            self.panel_options = panel_options
        if self.config.getboolean("panel", "enabled"):
            self.spawn("panel", [sys.executable, str(Path(__file__).with_name("madway-panel")), "bar"])
        else:
            self.terminate("panel")
        os.kill(self.parent, signal.SIGHUP)

    def compositor(self, command):
        with socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM) as channel:
            channel.sendto(command.encode(), str(self.directory / "compositor.sock"))

    def launcher(self, mode):
        existing = self.children.get("launcher")
        if existing is not None and existing.poll() is None:
            self.terminate("launcher")
            return
        self.spawn("launcher", ["wofi", "--show", mode, "--conf", str(SHARE / "wofi.conf"),
                   "--style", str(SHARE / "wofi.css"), "--term", "kitty", "--prompt",
                   "Applications" if mode == "drun" else "Run command or script"])

    def perform(self, message):
        name = message.get("action")
        if isinstance(name, str) and name.startswith("desktop-menu "):
            parts = name.split()
            if len(parts) != 3:
                raise RuntimeError("Invalid menu position")
            message.update(x=int(parts[1]), y=int(parts[2]));name = "desktop-menu"
        if name == "desktop-menu":
            self.terminate("desktop-menu")
            self.spawn("desktop-menu", [sys.executable, str(Path(__file__).with_name("madway-panel")), "menu",
                "--x", str(int(message.get("x", 0))), "--y", str(int(message.get("y", 0)))])
        elif name == "close-menu":
            self.terminate("desktop-menu")
        elif name == "workspace":
            value = int(message["value"])
            if not 0 <= value < 9:raise RuntimeError("Invalid workspace")
            self.compositor(f"workspace {value}")
        elif name in {"window-floating", "window-maximize", "window-fullscreen", "window-close"}:
            self.compositor(name.removeprefix("window-"))
        elif name == "terminal":
            process = subprocess.Popen(["kitty", "-o", "linux_display_server=wayland"], start_new_session=True)
            self.children[f"terminal-{process.pid}"] = process
        elif name in {"launcher", "run"}:
            self.launcher("drun" if name == "launcher" else "run")
        elif name in {"settings", "settings-page"}:
            page = message.get("page", "Windows")
            if page not in SETTINGS_PAGES:
                raise RuntimeError("Unknown settings page")
            process = self.spawn("settings", [sys.executable, str(Path(__file__).resolve()), "settings", "--page", page])
            if process is not None:
                attempts = 0
                def select_page():
                    nonlocal attempts
                    attempts += 1
                    try:
                        with socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM) as channel:
                            channel.sendto(page.encode(), str(self.directory / f"settings-{process.pid}.sock"))
                        self.compositor("focus-settings")
                        return False
                    except OSError:
                        return process.poll() is None and attempts < 10
                self.GLib.timeout_add(100, select_page)
            self.compositor("focus-settings")
        elif name == "apply":
            self.apply()
            self.notify("settings", "Settings applied")
        elif name in {"volume-up", "volume-down", "volume-mute", "set-volume"}:
            if name == "volume-mute":
                run(["wpctl", "set-mute", "@DEFAULT_AUDIO_SINK@", "toggle"])
            elif name == "set-volume":
                value = min(100, max(0, int(message["value"])))
                run(["wpctl", "set-volume", "--limit", "1.0", "@DEFAULT_AUDIO_SINK@", f"{value}%"])
            else:
                run(["wpctl", "set-volume", "--limit", "1.0", "@DEFAULT_AUDIO_SINK@", f"{min(20, max(1, self.config.getint('controls', 'volume_step')))}%" + ("+" if name == "volume-up" else "-")])
            value, muted = volume()
            self.notify("volume", "Volume muted" if muted else f"Volume {value}%", value=value)
        elif name in {"brightness-up", "brightness-down", "set-brightness"}:
            current = brightness()
            if current is None:
                raise RuntimeError("No backlight device available")
            value = int(message["value"]) if name == "set-brightness" else current + min(20, max(1, self.config.getint("controls", "brightness_step"))) * (1 if name == "brightness-up" else -1)
            set_brightness(value)
            value = brightness()
            self.notify("brightness", f"Brightness {value}%", value=value)
        elif name in {"startup-sound", "logout-sound", "shutdown-sound"}:
            event = name.removesuffix("-sound")
            if not self.config.getboolean("sounds", "enabled"):
                raise RuntimeError("Enable Session sounds in settings first")
            configured = self.config.get("sounds", event).strip()
            if not configured or not Path(configured).expanduser().is_file():
                raise RuntimeError(f"Choose an existing {event} sound file in settings")
            self.sound(event)
        elif name == "logout":
            os.kill(self.parent, signal.SIGTERM)
        elif name == "poweroff":
            self.sound("shutdown", wait=True)
            self.shutdown_played = True
            try:
                run(["systemctl", "poweroff"])
            except Exception:
                self.shutdown_played = False
                raise
        else:
            raise RuntimeError("Unknown desktop action")

    def receive(self, source, condition):
        del source, condition
        try:
            payload = json.loads(self.channel.recv(8192))
            if not isinstance(payload, dict):
                raise ValueError("Invalid action")
            self.perform(payload)
        except Exception as error:
            print(f"madway: desktop action failed: {error}", file=sys.stderr)
            self.notify("error", "Desktop action unavailable", str(error))
        return True

    def prepare_shutdown(self, connection, sender, path, interface, member, parameters):
        del connection, sender, path, interface, member
        if parameters.unpack()[0]:
            self.exit_event = "shutdown"
            if not self.shutdown_played:
                self.sound("shutdown")
                self.shutdown_played = True

    def stop(self):
        self.loop.quit()
        return False

    def serve(self):
        # User scripts placed here become available in the run launcher.
        os.environ["PATH"] = str(Path.home() / ".local" / "bin") + ":" + os.environ.get("PATH", "")
        os.environ.setdefault("GIO_USE_VFS", "local")
        try:
            if os.environ.get("MADWAY_NATIVE") == "1" and shutil.which("dbus-update-activation-environment"):
                try:
                    run(["dbus-update-activation-environment", "--systemd", "WAYLAND_DISPLAY", "XDG_CURRENT_DESKTOP", "XDG_SESSION_TYPE"])
                except (RuntimeError, subprocess.TimeoutExpired) as error:
                    print(f"madway: session activation environment: {error}", file=sys.stderr)
            self.apply()
            self.sound("startup")
            print(f"madway: desktop services ready on {self.socket_path}", flush=True)
            self.loop.run()
        finally:
            if not self.shutdown_played:
                self.sound(self.exit_event, wait=True)
            for key in list(self.children):
                self.terminate(key)
            self.channel.close()
            self.socket_path.unlink(missing_ok=True)
            (self.directory / "mako.conf").unlink(missing_ok=True)
            for path in self.directory.glob("settings-*.sock"):path.unlink(missing_ok=True)
            try:
                self.directory.rmdir()
            except OSError:
                pass


def settings_window(initial_page="Windows"):
    import gi
    gi.require_version("Gtk", "3.0")
    from gi.repository import Gtk, Gdk, GLib
    GLib.set_prgname("org.madway.Settings")
    config = settings()
    window = Gtk.Window(title="madway — Settings")
    # This owned client requests no CSD; madway supplies its compact 16px frame.
    window.set_decorated(False)
    window.set_default_size(700, 480)
    window.connect("destroy", Gtk.main_quit)
    provider = Gtk.CssProvider()
    provider.load_from_data(b"* { font-family: monospace; font-size: 12px; border-radius: 0; } window { background: #121418; color: #d2d6df; } button, entry, spinbutton, combobox { background: #1c1f24; color: #d2d6df; border: 1px solid #3a3f4b; } button:hover { border-color: #d97706; } stacksidebar { background: #1c1f24; } stacksidebar row, stacksidebar row label { color: #d2d6df; } stacksidebar row:hover, stacksidebar row:selected { background: #3a3f4b; } label { color: #d2d6df; padding: 1px; }")
    Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
    root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8, margin=8)
    window.add(root)
    content = Gtk.Box(spacing=10)
    root.pack_start(content, True, True, 0)
    stack = Gtk.Stack()
    sidebar = Gtk.StackSidebar()
    sidebar.set_stack(stack)
    sidebar.set_size_request(124, -1)
    content.pack_start(sidebar, False, False, 0)
    content.pack_start(stack, True, True, 0)
    status = Gtk.Label(xalign=0, wrap=True)
    root.pack_start(status, False, False, 0)

    def category(name):
        grid = Gtk.Grid(column_spacing=10, row_spacing=10, margin=6)
        scroll = Gtk.ScrolledWindow()
        scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        scroll.add(grid)
        stack.add_titled(scroll, name, name)
        return grid

    def field(grid, label, widget):
        row = len(grid.get_children()) // 2
        grid.attach(Gtk.Label(label=label, xalign=0), 0, row, 1, 1)
        widget.set_hexpand(True)
        grid.attach(widget, 1, row, 1, 1)
        return widget

    def spin(grid, label, section, key, lower, upper):
        widget = field(grid, label, Gtk.SpinButton.new_with_range(lower, upper, 1))
        widget.set_value(config.getint(section, key))
        return widget

    def combo(grid, label, values, selected):
        widget = Gtk.ComboBoxText()
        for key, text in values:
            widget.append(key, text)
        widget.set_active_id(selected)
        return field(grid, label, widget)

    def switch(grid, label, section, key):
        widget = field(grid, label, Gtk.Switch())
        widget.set_active(config.getboolean(section, key))
        widget.set_halign(Gtk.Align.START)
        return widget

    def file_field(grid, label, value):
        controls = Gtk.Box(spacing=6)
        entry = Gtk.Entry(text=value)
        entry.set_width_chars(18)
        controls.pack_start(entry, True, True, 0)
        browse = Gtk.Button(label="Browse…")
        def choose(button):
            dialog = Gtk.FileChooserDialog(title="Choose " + label.lower(), transient_for=window,
                    action=Gtk.FileChooserAction.OPEN)
            dialog.add_buttons("Cancel", Gtk.ResponseType.CANCEL, "Open", Gtk.ResponseType.OK)
            if dialog.run() == Gtk.ResponseType.OK:
                entry.set_text(dialog.get_filename())
            dialog.destroy()
        browse.connect("clicked", choose)
        controls.pack_end(browse, False, False, 0)
        field(grid, label, controls)
        return entry

    def send(name, **values):
        try:
            action(name, **values)
            status.set_text("")
        except Exception as error:
            status.set_text(str(error))
        return False

    windows = category("Windows")
    default_mode = combo(windows, "New windows", [("floating", "Floating"), ("tiled", "Master / stack tiles")],
                         config.get("windows", "default_mode"))
    default_mode.set_tooltip_text("Applies to new windows; existing windows keep their mode")
    title = spin(windows, "Title height (px)", "appearance", "title_height", 14, 24)
    gap = spin(windows, "Tile gaps (px)", "appearance", "tile_gap", 0, 12)
    master = spin(windows, "Master width (%)", "windows", "master_percent", 25, 75)
    floating_hint = field(windows, "Floating / tiling", Gtk.Label(xalign=0))

    displays = category("Displays")
    display_rows = []
    display_message = Gtk.Label(xalign=0, wrap=True)
    def read_outputs():
        return json.loads((runtime_directory() / "outputs.json").read_text())
    def load_displays(button=None):
        for child in displays.get_children():
            displays.remove(child)
        display_rows.clear()
        refresh = Gtk.Button(label="Refresh connected monitors")
        refresh.connect("clicked", load_displays)
        field(displays, "Monitor list", refresh)
        try:
            snapshot = read_outputs()
            display_message.set_text(snapshot.get("error", ""))
            for output in snapshot["outputs"]:
                controls = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=5)
                grid = Gtk.Grid(column_spacing=8, row_spacing=6)
                controls.pack_start(Gtk.Label(label=output.get("description") or output["name"], xalign=0, wrap=True), False, False, 0)
                controls.pack_start(grid, False, False, 0)
                enabled = field(grid, "Enabled", Gtk.Switch())
                enabled.set_active(output["enabled"])
                options = [("preferred", "Preferred")]
                seen = {"preferred"}
                for mode in [dict(width=output["width"], height=output["height"], refresh=output["refresh"]), *output["modes"]]:
                    key = f"{mode['width']}x{mode['height']}@{mode['refresh']}"
                    if key not in seen:
                        options.append((key, f"{mode['width']} × {mode['height']} / {mode['refresh'] / 1000:g} Hz"))
                        seen.add(key)
                selected = f"{output['width']}x{output['height']}@{output['refresh']}"
                resolution = combo(grid, "Resolution / refresh", options, selected)
                positions = []
                for label, value in [("X position", output["x"]), ("Y position", output["y"])]:
                    control = field(grid, label, Gtk.SpinButton.new_with_range(-32768, 32768, 1))
                    control.set_value(value);positions.append(control)
                scale = field(grid, "Scale", Gtk.SpinButton.new_with_range(.5, 4, .25))
                scale.set_digits(2);scale.set_value(output["scale"])
                rotation = combo(grid, "Rotation", [(str(i), text) for i, text in enumerate(
                    ["Normal", "90°", "180°", "270°", "Flipped", "Flipped 90°", "Flipped 180°", "Flipped 270°"])], str(output["transform"]))
                field(displays, output["name"], controls)
                row = dict(name=output["name"], enabled=enabled, mode=resolution, x=positions[0], y=positions[1], scale=scale, transform=rotation)
                row["original"] = display_values(row)
                display_rows.append(row)
            if not snapshot["outputs"]:
                display_message.set_text("No connected outputs reported")
        except (OSError, ValueError, KeyError) as error:
            display_message.set_text("Monitor information unavailable: " + str(error))
        field(displays, "Status", display_message)
        displays.show_all()
    def display_values(row):
        return dict(enabled=str(row["enabled"].get_active()).lower(), mode=row["mode"].get_active_id(),
                    x=str(row["x"].get_value_as_int()), y=str(row["y"].get_value_as_int()),
                    scale=str(row["scale"].get_value()), transform=row["transform"].get_active_id())
    load_displays()

    appearance = category("Appearance")
    image = file_field(appearance, "Wallpaper", config.get("wallpaper", "path"))
    mode = combo(appearance, "Wallpaper fit", [(item, item.capitalize()) for item in ["fill", "fit", "center", "stretch", "tile"]], config.get("wallpaper", "mode"))
    color = field(appearance, "Background color", Gtk.Entry(text=config.get("wallpaper", "color")))

    inputs = category("Input")
    modifier = combo(inputs, "Shortcut / drag modifier", [("alt", "Alt"), ("super", "Super / Windows")], config.get("input", "modifier"))
    repeat_rate = spin(inputs, "Repeat rate (keys/s)", "input", "repeat_rate", 1, 100)
    repeat_delay = spin(inputs, "Repeat delay (ms)", "input", "repeat_delay", 100, 1500)
    shortcut_help = Gtk.Label(xalign=0, selectable=True, wrap=True)
    def update_shortcuts(widget=None):
        prefix = "Super" if modifier.get_active_id() == "super" else "Alt"
        floating_hint.set_text(f"{prefix}+T (also {prefix}+Space)")
        shortcut_help.set_text("\n".join(f"{prefix}+{keys}   {description}" for keys, description in
            [("Enter", "Kitty"), ("T / Space", "Floating / tiled"), ("F", "Fullscreen"), ("M", "Maximize"),
             ("D / Shift+D", "Apps / commands"), (",", "Settings"), ("1–9", "Workspace"),
             ("Shift+1–9", "Move to workspace"), ("Tab", "Next window"), ("Q", "Close window"),
             ("Escape", "Log out"), ("left / right drag", "Move / resize")]))
    modifier.connect("changed", update_shortcuts);update_shortcuts()
    field(inputs, "Shortcuts", shortcut_help)

    notifications_page = category("Notifications")
    notifications = switch(notifications_page, "Application notifications", "notifications", "enabled")
    indicators = switch(notifications_page, "Media-key indicators", "notifications", "indicators")
    timeout = spin(notifications_page, "Default timeout (ms)", "notifications", "timeout", 1000, 15000)
    notify_width = spin(notifications_page, "Popup width (px)", "notifications", "width", 200, 600)
    anchor = combo(notifications_page, "Position", [(item, item.replace("-", " ").title()) for item in
                   ["top-right", "top-left", "bottom-right", "bottom-left"]], config.get("notifications", "anchor"))

    audio = category("Audio & brightness")
    def hardware_slider(label, getter, name):
        slider = field(audio, label, Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0 if name == "set-volume" else 1, 100, 1))
        try:
            current = getter()
            if current is None:
                slider.set_sensitive(False)
            else:
                slider.set_value(current)
        except Exception:
            slider.set_sensitive(False)
        slider.connect("button-release-event", lambda widget, event: send(name, value=round(widget.get_value())))
        slider.connect("key-release-event", lambda widget, event: send(name, value=round(widget.get_value())))
    hardware_slider("Output volume", lambda: volume()[0], "set-volume")
    mute = Gtk.Button(label="Toggle mute");mute.connect("clicked", lambda button: send("volume-mute"));field(audio, "Output mute", mute)
    hardware_slider("Display brightness", brightness, "set-brightness")
    volume_step = spin(audio, "Volume key step (%)", "controls", "volume_step", 1, 20)
    brightness_step = spin(audio, "Brightness key step (%)", "controls", "brightness_step", 1, 20)
    sounds = switch(audio, "Session sounds", "sounds", "enabled")
    sound_paths = {}
    for event in ("startup", "logout", "shutdown"):
        sound_paths[event] = file_field(audio, event.capitalize() + " sound", config.get("sounds", event))
    sound_volume = field(audio, "Sound level", Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, 100, 5))
    sound_volume.set_value(config.getfloat("sounds", "volume") * 100)

    session = category("Session")
    for label, command in [("Application launcher", "launcher"), ("Run a command", "run"), ("Log out of madway", "logout")]:
        button = Gtk.Button(label=label);button.connect("clicked", lambda button, name=command: send(name));field(session, "", button)
    power = Gtk.Button(label="Shut down computer…")
    def shutdown(button):
        dialog = Gtk.MessageDialog(transient_for=window, modal=True, message_type=Gtk.MessageType.QUESTION,
                buttons=Gtk.ButtonsType.OK_CANCEL, text="Shut down this computer?")
        response = dialog.run();dialog.destroy()
        if response == Gtk.ResponseType.OK:send("poweroff")
    power.connect("clicked", shutdown);field(session, "", power)

    panel_page = category("Panel")
    panel_enabled = switch(panel_page, "Top bar", "panel", "enabled")
    panel_height = spin(panel_page, "Bar height (px)", "panel", "height", 20, 32)
    panel_metrics = switch(panel_page, "CPU / RAM status", "panel", "metrics")
    panel_clock = switch(panel_page, "Clock", "panel", "clock")

    def save(button=None):
        try:
            if not re.fullmatch(r"#[0-9a-fA-F]{6}", color.get_text()):
                raise ValueError("Use a background color such as #121418")
            if image.get_text() and not Path(image.get_text()).expanduser().is_file():
                raise ValueError("Wallpaper image does not exist")
            paths = {event: entry.get_text().strip() for event, entry in sound_paths.items()}
            for event, path in paths.items():
                if path and not Path(path).expanduser().is_file():raise ValueError(f"The {event} sound file does not exist")
            if sounds.get_active() and not any(paths.values()):raise ValueError("Choose a sound file before enabling Session sounds")
            if display_rows and not any(row["enabled"].get_active() for row in display_rows):
                raise ValueError("Keep at least one monitor enabled")
            if any(display_values(row) != row["original"] for row in display_rows):
                for row in display_rows:
                    config['output:' + row['name']] = display_values(row)
            config["appearance"].update(title_height=str(title.get_value_as_int()), tile_gap=str(gap.get_value_as_int()))
            config["windows"].update(default_mode=default_mode.get_active_id(), master_percent=str(master.get_value_as_int()))
            config["input"].update(modifier=modifier.get_active_id(), repeat_rate=str(repeat_rate.get_value_as_int()), repeat_delay=str(repeat_delay.get_value_as_int()))
            config["panel"].update(enabled=str(panel_enabled.get_active()).lower(), height=str(panel_height.get_value_as_int()),
                metrics=str(panel_metrics.get_active()).lower(), clock=str(panel_clock.get_active()).lower())
            config["controls"].update(volume_step=str(volume_step.get_value_as_int()), brightness_step=str(brightness_step.get_value_as_int()))
            config["wallpaper"].update(path=image.get_text(), mode=mode.get_active_id(), color=color.get_text())
            config["notifications"].update(enabled=str(notifications.get_active()).lower(), indicators=str(indicators.get_active()).lower(),
                timeout=str(timeout.get_value_as_int()), width=str(notify_width.get_value_as_int()), anchor=anchor.get_active_id())
            config["sounds"].update(enabled=str(sounds.get_active()).lower(), volume=str(sound_volume.get_value() / 100), **paths)
            CONFIG.parent.mkdir(parents=True, exist_ok=True)
            with tempfile.NamedTemporaryFile("w", dir=CONFIG.parent, delete=False) as temporary:
                config.write(temporary);temporary_path = Path(temporary.name)
            temporary_path.replace(CONFIG)
            action("apply")
            status.set_text("Settings saved. Display changes are checked by the compositor.")
            GLib.timeout_add(800, display_feedback)
            return True
        except Exception as error:
            status.set_text(str(error));return False
    def display_feedback():
        try:
            error = read_outputs().get("error", "")
            if error:status.set_text(error)
        except (OSError, ValueError):pass
        return False
    def preview_sound(button):
        if save():send("startup-sound")
    preview = Gtk.Button(label="Save and preview startup sound")
    preview.connect("clicked", preview_sound);field(audio, "Preview", preview)
    buttons = Gtk.Box(spacing=8)
    root.pack_end(buttons, False, False, 0)
    apply_button = Gtk.Button(label="Apply");apply_button.connect("clicked", save)
    buttons.pack_end(apply_button, False, False, 0)
    close = Gtk.Button(label="Close");close.connect("clicked", lambda button: window.destroy())
    buttons.pack_end(close, False, False, 0)
    stack.set_visible_child_name(initial_page)
    page_channel = socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM)
    page_path = runtime_directory() / f"settings-{os.getpid()}.sock"
    page_path.unlink(missing_ok=True)
    page_channel.bind(str(page_path));page_channel.setblocking(False)
    def select_page(source, condition):
        page = page_channel.recv(256).decode()
        if page in SETTINGS_PAGES:
            stack.set_visible_child_name(page)
            window.present()
        return True
    page_watch = GLib.io_add_watch(page_channel.fileno(), GLib.IO_IN, select_page)
    def close_channel(widget):
        GLib.source_remove(page_watch);page_channel.close();page_path.unlink(missing_ok=True)
    window.connect("destroy", close_channel)
    window.show_all()
    Gtk.main()


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("command", choices=["serve", "settings", "action", "doctor"])
    parser.add_argument("name", nargs="?")
    parser.add_argument("--compositor-pid", type=int)
    parser.add_argument("--value", type=int)
    parser.add_argument("--page", choices=SETTINGS_PAGES, default="Windows")
    arguments = parser.parse_args()
    if arguments.command == "serve":
        if not arguments.compositor_pid:
            parser.error("serve requires --compositor-pid")
        Desktop(arguments.compositor_pid).serve()
    elif arguments.command == "settings":
        settings_window(arguments.page)
    elif arguments.command == "doctor":
        print(json.dumps({"programs": {name: shutil.which(name) for name in
            ["mako", "wofi", "swaybg", "kitty", "grim", "wpctl", "brightnessctl", "busctl", "pw-play", "paplay"]},
            "backlight": [path.name for path in Path("/sys/class/backlight").glob("*")],
            "settings": str(CONFIG)}, indent=2))
    else:
        if not arguments.name:
            parser.error("action requires an action name")
        values = {"value": arguments.value} if arguments.value is not None else {}
        action(arguments.name, **values)


if __name__ == "__main__":
    try:
        main()
    except Exception as error:
        print(f"madway-shell: {error}", file=sys.stderr)
        sys.exit(1)
