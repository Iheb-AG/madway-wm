PAGES = api['SETTINGS_PAGES']
MENU_PAGES = ('Desktop', 'Settings', 'Window', 'Workspaces', 'Audio', 'Status', 'Clock', 'Session', 'Demoscenes', 'Battery', 'Screenshot','Application')
