#!/usr/bin/env python3
"""Compact layer-shell top bars and the shared desktop utility menu."""
import argparse
from datetime import datetime
import json
from pathlib import Path
import runpy
import threading

import gi
gi.require_version('Gtk', '3.0')
gi.require_version('GtkLayerShell', '0.1')
from gi.repository import Gtk, Gdk, GLib, GtkLayerShell as Layer

api = runpy.run_path(str(Path(__file__).resolve().with_name('madway-shell')))
action = api['action']
settings = api['settings']
runtime_directory = api['runtime_directory']
PAGES = api['SETTINGS_PAGES']
CSS = b'''
* { font-family: monospace; font-size: 11px; border-radius: 0; }
window { background: #1c1f24; color: #d2d6df; }
button { min-width: 0; min-height: 0; padding: 0 6px; margin: 0; border: 0; background: transparent; color: #d2d6df; box-shadow: none; }
button:hover, button:focus { background: #3a3f4b; }
button.active, button.brand { color: #d97706; }
.bar { border-bottom: 1px solid #3a3f4b; }
.menu { background-color: #1c1f24; color: #d2d6df; border: 1px solid #3a3f4b; padding: 3px; }
.menu button { padding: 4px 8px; }
.menu label { color: #d2d6df; }
.menu .menu-title { color: #d97706; padding: 4px 8px; }
separator { background: #3a3f4b; min-width: 1px; min-height: 1px; }
'''


def send(name, **values):
    try:
        action(name, **values)
    except OSError as error:
        print('madway panel: ' + str(error), flush=True)


def layer_window(namespace, monitor, layer, keyboard):
    window = Gtk.Window()
    window.set_decorated(False)
    Layer.init_for_window(window)
    Layer.set_namespace(window, namespace)
    Layer.set_monitor(window, monitor)
    Layer.set_layer(window, layer)
    Layer.set_keyboard_mode(window, keyboard)
    return window


class TopBar:
    def __init__(self):
        self.config = settings()
        self.display = Gdk.Display.get_default()
        self.bars = []
        self.last_cpu = None
        self.polling = False
        self.rebuild_source = 0
        self.display.connect('monitor-added', lambda *args: self.queue_rebuild())
        self.display.connect('monitor-removed', lambda *args: self.queue_rebuild())
        self.rebuild()
        GLib.timeout_add(500, self.refresh)
        GLib.timeout_add_seconds(3, self.metrics)
        self.metrics()

    def queue_rebuild(self):
        if self.rebuild_source:
            GLib.source_remove(self.rebuild_source)
        self.rebuild_source = GLib.timeout_add(100, self.rebuild)

    def rebuild(self):
        self.rebuild_source = 0
        for bar in self.bars:
            bar['window'].destroy()
        self.bars.clear()
        height = min(32, max(20, self.config.getint('panel', 'height')))
        for index in range(self.display.get_n_monitors()):
            monitor = self.display.get_monitor(index)
            if monitor is None:continue
            window = layer_window('madway-panel', monitor, Layer.Layer.TOP, Layer.KeyboardMode.NONE)
            for edge in (Layer.Edge.TOP, Layer.Edge.LEFT, Layer.Edge.RIGHT):
                Layer.set_anchor(window, edge, True)
            Layer.set_exclusive_zone(window, height)
            window.set_size_request(-1, height)
            box = Gtk.Box(spacing=0)
            box.get_style_context().add_class('bar')
            window.add(box)
            def button(label, callback, tooltip=''):
                widget = Gtk.Button(label=label)
                widget.set_can_focus(False)
                widget.set_tooltip_text(tooltip or label)
                widget.connect('clicked', callback)
                box.pack_start(widget, False, False, 0)
                return widget
            def open_menu(widget, monitor=monitor):
                bounds = monitor.get_geometry()
                send('desktop-menu', x=bounds.x, y=bounds.y+height)
            brand = button('madway', open_menu, 'Desktop menu')
            brand.get_style_context().add_class('brand')
            apps = button('Apps', lambda widget: send('launcher'), 'Search installed applications')
            run_button = button('Run', lambda widget: send('run'), 'Run a command or script')
            settings_button = button('Settings', lambda widget: send('settings'))
            box.pack_start(Gtk.Separator(orientation=Gtk.Orientation.VERTICAL), False, False, 5)
            workspaces = []
            for number in range(9):
                workspaces.append(button(str(number+1), lambda widget, number=number: send('workspace', value=number), f'Workspace {number+1}'))
            title = Gtk.Label(xalign=0)
            title.set_ellipsize(3)
            title.set_margin_start(10)
            box.pack_start(title, True, True, 0)
            metrics = Gtk.Label()
            metrics.set_margin_end(10)
            box.pack_start(metrics, False, False, 0)
            audio = button('VOL', lambda widget: send('settings-page', page='Audio & brightness'))
            clock = Gtk.Label()
            clock.set_margin_start(8);clock.set_margin_end(8)
            box.pack_start(clock, False, False, 0)
            session_button = button('Session', lambda widget: send('settings-page', page='Session'))
            utilities = [apps, run_button, settings_button, session_button]
            for widget in [*utilities, *workspaces, metrics]:widget.set_no_show_all(True)
            self.bars.append(dict(window=window, title=title, workspaces=workspaces, metrics=metrics, audio=audio, clock=clock, monitor=monitor, utilities=utilities))
            window.show_all()
        self.refresh()
        return False

    def refresh(self):
        try:
            state = json.loads((runtime_directory()/'desktop.json').read_text())
        except (OSError, ValueError):
            state = {}
        for bar in self.bars:
            compact = bar['monitor'].get_geometry().width < 700
            for widget in bar['utilities']:widget.set_visible(not compact)
            bar['metrics'].set_visible(bar['monitor'].get_geometry().width >= 1000 and self.config.getboolean('panel', 'metrics'))
            bar['title'].set_text(state.get('title', ''))
            for number, button in enumerate(bar['workspaces']):
                button.set_visible(not compact or number == state.get('workspace', 0))
                style = button.get_style_context()
                (style.add_class if number == state.get('workspace', 0) else style.remove_class)('active')
            bar['clock'].set_text(datetime.now().astimezone().strftime('%H:%M') if self.config.getboolean('panel', 'clock') else '')
        return True

    def metrics(self):
        if self.polling:
            return True
        self.polling = True
        def read():
            telemetry = ''
            audio = 'Audio'
            try:
                values = [int(value) for value in Path('/proc/stat').read_text().splitlines()[0].split()[1:9]]
                total = sum(values);idle = values[3]+values[4]
                cpu = 0 if self.last_cpu is None or total == self.last_cpu[0] else round(100*(1-(idle-self.last_cpu[1])/(total-self.last_cpu[0])))
                self.last_cpu = (total, idle)
                memory = {line.split(':')[0]:int(line.split()[1]) for line in Path('/proc/meminfo').read_text().splitlines() if ':' in line}
                used = (memory['MemTotal']-memory['MemAvailable'])/(1024*1024)
                telemetry = f'CPU {cpu}%  RAM {used:.1f}G'
            except (OSError, ValueError, KeyError):
                pass
            try:
                level, muted = api['volume']()
                audio = 'MUTE' if muted else f'VOL {level}%'
            except Exception:
                pass
            GLib.idle_add(self.update_metrics, telemetry, audio)
        threading.Thread(target=read, daemon=True).start()
        return True

    def update_metrics(self, telemetry, audio):
        self.polling = False
        for bar in self.bars:
            bar['metrics'].set_text(telemetry if self.config.getboolean('panel', 'metrics') else '')
            bar['audio'].set_label(audio)
        return False


class DesktopMenu:
    def __init__(self, x, y):
        display = Gdk.Display.get_default()
        monitor = display.get_monitor(0)
        for index in range(display.get_n_monitors()):
            candidate = display.get_monitor(index)
            rect = candidate.get_geometry()
            if rect.x <= x < rect.x+rect.width and rect.y <= y < rect.y+rect.height:
                monitor = candidate;break
        rect = monitor.get_geometry()
        self.window = layer_window('madway-menu', monitor, Layer.Layer.OVERLAY, Layer.KeyboardMode.EXCLUSIVE)
        Layer.set_exclusive_zone(self.window, -1)
        Layer.set_anchor(self.window, Layer.Edge.TOP, True)
        Layer.set_anchor(self.window, Layer.Edge.LEFT, True)
        Layer.set_margin(self.window, Layer.Edge.LEFT, min(max(0, int(x-rect.x)), max(0, rect.width-244)))
        Layer.set_margin(self.window, Layer.Edge.TOP, min(max(0, int(y-rect.y)), max(0, rect.height-300)))
        self.box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        self.box.get_style_context().add_class('menu')
        self.window.add(self.box)
        self.window.set_size_request(240, -1)
        self.window.connect('destroy', Gtk.main_quit)
        self.window.connect('key-press-event', self.key)
        self.buttons = []
        self.page = 'Desktop'
        self.show_page('Desktop')
        self.window.show_all()

    def activate(self, name, **values):
        send(name, **values)
        self.window.destroy()

    def show_page(self, page):
        self.page = page
        for widget in self.box.get_children():
            self.box.remove(widget)
        self.buttons.clear()
        label = Gtk.Label(label='madway' if page == 'Desktop' else page, xalign=0)
        label.get_style_context().add_class('menu-title')
        self.box.pack_start(label, False, False, 0)
        def item(label, callback):
            button = Gtk.Button(label=label)
            button.set_halign(Gtk.Align.FILL)
            button.get_child().set_xalign(0)
            button.connect('clicked', lambda widget: callback())
            self.box.pack_start(button, False, False, 0)
            self.buttons.append(button)
        if page != 'Desktop':
            item('‹ Back', lambda: self.show_page('Desktop'))
        if page == 'Desktop':
            item('Applications', lambda: self.activate('launcher'))
            item('Run command…', lambda: self.activate('run'))
            item('Kitty terminal', lambda: self.activate('terminal'))
            for label in ('Settings', 'Window', 'Workspaces', 'Session'):
                item(label+' ›', lambda label=label: self.show_page(label))
            item('Reload settings', lambda: self.activate('apply'))
        elif page == 'Settings':
            for name in PAGES:
                item(name, lambda name=name: self.activate('settings-page', page=name))
        elif page == 'Window':
            for label, command in [('Floating / tiled', 'floating'), ('Maximize / restore', 'maximize'), ('Fullscreen', 'fullscreen'), ('Close window', 'close')]:
                item(label, lambda command=command: self.activate('window-'+command))
        elif page == 'Workspaces':
            for number in range(9):
                item('Workspace '+str(number+1), lambda number=number: self.activate('workspace', value=number))
        elif page == 'Session':
            item('Session settings…', lambda: self.activate('settings-page', page='Session'))
            item('Log out', lambda: self.activate('logout'))
            # Power-off remains behind the settings window's explicit confirmation.
            item('Shut down computer…', lambda: self.activate('settings-page', page='Session'))
        self.box.show_all()
        self.buttons[0].grab_focus()

    def key(self, window, event):
        key = Gdk.keyval_name(event.keyval)
        if key == 'Escape':
            self.window.destroy();return True
        if key == 'Left' and self.page != 'Desktop':
            self.show_page('Desktop');return True
        if key in ('Up', 'Down'):
            focused = self.window.get_focus()
            index = self.buttons.index(focused) if focused in self.buttons else -1
            self.buttons[(index+(1 if key == 'Down' else -1))%len(self.buttons)].grab_focus()
            return True
        if key in ('Return', 'KP_Enter') and self.window.get_focus() in self.buttons:
            self.window.get_focus().clicked();return True
        return False


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('mode', choices=['bar', 'menu'])
    parser.add_argument('--x', type=int, default=0)
    parser.add_argument('--y', type=int, default=0)
    options = parser.parse_args()
    provider = Gtk.CssProvider();provider.load_from_data(CSS)
    Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
    component = TopBar() if options.mode == 'bar' else DesktopMenu(options.x, options.y)
    Gtk.main()


if __name__ == '__main__':
    main()
