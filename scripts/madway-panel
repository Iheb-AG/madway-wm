def send(name, **values):
    try:
        action(name, **values)
    except OSError as error:
        print('madway panel: ' + str(error), flush=True)


def layer_window(namespace, monitor, layer, keyboard):
    window = Gtk.Window()
    window.set_decorated(False)
    visual = window.get_screen().get_rgba_visual()
    if visual is not None:window.set_visual(visual)
    Layer.init_for_window(window)
    Layer.set_namespace(window, namespace)
    Layer.set_monitor(window, monitor)
    Layer.set_layer(window, layer)
    Layer.set_keyboard_mode(window, keyboard)
    return window


class TopBar:
    def __init__(self):
        self.config = settings()
        self.argent = self.config.get('appearance', 'theme') in {'argent','argent-dark'}
        self.display = Gdk.Display.get_default()
        self.bars = []
        self.last_cpu = None
        self.polling = False
        self.rebuild_source = 0
        self.display.connect('monitor-added', lambda *args: self.queue_rebuild())
        self.display.connect('monitor-removed', lambda *args: self.queue_rebuild())
        self.rebuild()
        GLib.timeout_add(500, self.refresh)
        GLib.timeout_add_seconds(3, self.metrics)
        self.metrics()

    def queue_rebuild(self):
        if self.rebuild_source:
            GLib.source_remove(self.rebuild_source)
        self.rebuild_source = GLib.timeout_add(100, self.rebuild)

    def rebuild(self):
        self.rebuild_source = 0
        for bar in self.bars:
            bar['window'].destroy()
        self.bars.clear()
        height = min(32, max(16, self.config.getint('panel', 'height')))
        position = self.config.get('panel', 'position')
        if position not in ('top', 'bottom', 'left', 'right'):position = 'top'
        vertical = position in ('left', 'right')
        arrow = '' if self.argent else '▴' if position == 'bottom' else '▾'
        for index in range(self.display.get_n_monitors()):
            monitor = self.display.get_monitor(index)
            if monitor is None:continue
            window = layer_window('madway-panel', monitor, Layer.Layer.TOP, Layer.KeyboardMode.NONE)
            edges = {'top':(Layer.Edge.TOP, Layer.Edge.LEFT, Layer.Edge.RIGHT),
                     'bottom':(Layer.Edge.BOTTOM, Layer.Edge.LEFT, Layer.Edge.RIGHT),
                     'left':(Layer.Edge.LEFT, Layer.Edge.TOP, Layer.Edge.BOTTOM),
                     'right':(Layer.Edge.RIGHT, Layer.Edge.TOP, Layer.Edge.BOTTOM)}
            for edge in edges[position]:
                Layer.set_anchor(window, edge, True)
            Layer.set_exclusive_zone(window, height)
            window.set_size_request(height if vertical else -1, -1 if vertical else height)
            def dismiss_blank(window,event):
                widget=Gtk.get_event_widget(event)
                while widget and widget is not window:
                    if isinstance(widget,Gtk.Button):return False
                    widget=widget.get_parent()
                send('close-menu');return False
            window.add_events(Gdk.EventMask.BUTTON_PRESS_MASK)
            window.connect('button-press-event',dismiss_blank)
            box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL if vertical else Gtk.Orientation.HORIZONTAL, spacing=min(12,max(0,self.config.getint('panel','spacing'))))
            box.get_style_context().add_class('bar')
            box.get_style_context().add_class(position)
            window.add(box)
            def button(label, page, expand=False, tooltip='', monitor=monitor):
                widget = Gtk.Button(label=label)
                widget.set_can_focus(False)
                widget.set_tooltip_text(tooltip or page)
                def popup(widget, window=window):
                    bounds = monitor.get_geometry()
                    allocation = widget.get_allocation()
                    x, y = bounds.x+allocation.x, bounds.y+allocation.y
                    if position == 'top':y = bounds.y+window.get_allocated_height()
                    elif position == 'bottom':y = bounds.y+bounds.height-window.get_allocated_height()
                    elif position == 'left':x = bounds.x+window.get_allocated_width()
                    else:x = bounds.x+bounds.width-window.get_allocated_width()
                    send('panel-menu', page=page, x=x, y=y, edge=position,
                         detail=widget.get_tooltip_text() if vertical else widget.get_label())
                widget.connect('clicked', popup)
                box.pack_start(widget, expand, expand, 0)
                return widget
            name=api['panel_label'](self.config)
            brand = button(name[:1].upper() if vertical else name+(' '+arrow if arrow else ''), 'Desktop', tooltip=name+' · Applications, commands and settings')
            brand.get_child().set_ellipsize(3);brand.get_child().set_max_width_chars(18)
            brand.get_style_context().add_class('brand')
            workspace = button('1 ▾', 'Workspaces')
            title = button('Desktop ▾', 'Window', tooltip='Active window actions')
            title.get_child().set_max_width_chars(18)
            if self.argent:
                title.get_style_context().add_class('application')
                box.reorder_child(title, 1)
            title.get_child().set_xalign(.5 if vertical else 0)
            title.get_child().set_ellipsize(3)
            # Keep every minimized window reachable without growing the panel.
            minimized = Gtk.ScrolledWindow()
            minimized.set_policy(Gtk.PolicyType.NEVER if vertical else Gtk.PolicyType.EXTERNAL,
                                 Gtk.PolicyType.EXTERNAL if vertical else Gtk.PolicyType.NEVER)
            minimized.set_overlay_scrolling(False)
            minimized.add_events(Gdk.EventMask.SCROLL_MASK | Gdk.EventMask.SMOOTH_SCROLL_MASK)
            minimized.connect('scroll-event', self.scroll_minimized, vertical)
            minimized.set_no_show_all(True)
            minimized_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL if vertical else Gtk.Orientation.HORIZONTAL, spacing=0)
            minimized.add(minimized_box)
            minimized.set_size_request(-1 if vertical else 80, 64 if vertical else -1)
            box.pack_start(minimized, True, True, 0)
            box.reorder_child(minimized, box.get_children().index(workspace)+1)
            spacer=Gtk.Box();spacer.set_no_show_all(True)
            box.pack_start(spacer,True,True,0)
            metrics = button('', 'Status', tooltip='System status')
            metrics.set_no_show_all(True)
            audio = button('V' if vertical else 'Audio '+arrow, 'Audio')
            if self.argent:
                audio.set_label('')
                audio.set_always_show_image(True)
                icon=Gtk.Image.new_from_icon_name('audio-volume-high-symbolic',Gtk.IconSize.MENU)
                icon.set_pixel_size(18);audio.set_image(icon)
            battery = button('', 'Battery', tooltip='Battery and charging status')
            battery.set_no_show_all(True)
            clock = button('', 'Clock')
            clock.set_no_show_all(True)
            session = button('', 'Session', tooltip='Session · Lock, sleep, log out, restart or shut down')
            session_icon=Gtk.Image.new_from_icon_name('system-shutdown-symbolic',Gtk.IconSize.MENU)
            session_icon.set_pixel_size(14)
            session.set_image(session_icon);session.set_always_show_image(True)
            session.set_no_show_all(True)
            self.bars.append(dict(window=window, title=title, workspace=workspace, metrics=metrics,
                audio=audio, battery=battery, clock=clock, monitor=monitor, session=session, vertical=vertical, position=position, arrow=arrow,
                minimized=minimized, minimized_box=minimized_box, minimized_signature=None, empty_space=spacer,
                buttons=[widget for widget in box.get_children() if isinstance(widget, Gtk.Button)]))
            window.show_all()
        self.refresh()
        return False

    @staticmethod
    def scroll_minimized(widget, event, vertical):
        adjustment = widget.get_vadjustment() if vertical else widget.get_hadjustment()
        maximum = max(0, adjustment.get_upper()-adjustment.get_page_size())
        if maximum <= 0:return False
        if event.direction == Gdk.ScrollDirection.SMOOTH:
            valid, dx, dy = event.get_scroll_deltas()
            if not valid:return False
            delta = dy if vertical or not dx else dx
        else:
            delta = -1 if event.direction in (Gdk.ScrollDirection.UP, Gdk.ScrollDirection.LEFT) else 1
        adjustment.set_value(max(0, min(maximum, adjustment.get_value()+32*delta)))
        return True

    def refresh(self):
        try:
            state = json.loads((runtime_directory()/'desktop.json').read_text())
        except (OSError, ValueError):
            state = {}
        power = api['power_snapshot']()
        for bar in self.bars:
            bounds = bar['monitor'].get_geometry()
            vertical = bar['vertical']
            output_state=next((row for row in state.get('output_workspaces',[]) if row.get('x')==bounds.x and row.get('y')==bounds.y),state)
            rows=[row for row in state.get('all_windows',state.get('windows',[])) if row.get('visible_workspace',True) and
                ('name' not in output_state or row.get('output')==output_state['name'])]
            signature = tuple((row['id'], row.get('title') or 'Untitled',row.get('app_id',''),row.get('minimized',False),row.get('focused',False)) for row in rows)
            if signature != bar['minimized_signature']:
                bar['minimized_signature'] = signature
                for child in bar['minimized_box'].get_children():child.destroy()
                for identity, title, app_id, hidden, focused in signature:
                    mode=self.config.get('panel','tasks')
                    name=app_id.removeprefix('org.').split('.')[-1] or title
                    try:app=Gio.DesktopAppInfo.new(app_id+'.desktop') if app_id else None
                    except (TypeError,GLib.Error):app=None
                    if app:name=app.get_display_name()
                    widget = Gtk.Button(label='' if mode=='icons' else name)
                    label=widget.get_child()
                    label.set_ellipsize(3);label.set_max_width_chars(20)
                    icon=app.get_icon() if app else Gio.ThemedIcon.new('application-x-executable')
                    image=Gtk.Image.new_from_gicon(icon or Gio.ThemedIcon.new('application-x-executable'),Gtk.IconSize.MENU)
                    image.set_pixel_size(16)
                    if mode=='icons':widget.set_image(image);widget.set_always_show_image(True)
                    if vertical and mode=='names':label.set_angle(90)
                    widget.set_can_focus(False)
                    if hidden:widget.get_style_context().add_class('minimized')
                    if focused:widget.get_style_context().add_class('selected')
                    widget.set_tooltip_text(('Restore ' if hidden else 'Minimize ' if focused else 'Focus ')+title+' · Scroll for more applications')
                    if self.config.getboolean('panel','previews'):
                        widget.preview=widgets['TaskPreview'](widget,identity,runtime_directory,send)
                    widget.connect('clicked', lambda widget, identity=identity:send('taskbar-toggle', id=identity))
                    def context(widget,event,identity=identity,entry=bar):
                        if event.button!=3:return False
                        bounds=entry['monitor'].get_geometry();window=entry['window']
                        point=widget.translate_coordinates(window,int(event.x),int(event.y)) or (0,0)
                        x=bounds.x+point[0]+(bounds.width-window.get_allocated_width() if entry['position']=='right' else 0)
                        y=bounds.y+point[1]+(bounds.height-window.get_allocated_height() if entry['position']=='bottom' else 0)
                        send('application-menu',id=identity,x=x,y=y);return True
                    widget.connect('button-press-event',context)
                    bar['minimized_box'].pack_start(widget, False, False, 0)
                    widget.show_all()
                    if not vertical and mode=='names':
                        widget.set_size_request(min(170, max(48, widget.get_preferred_width()[1])), -1)
                bar['minimized_box'].show_all()
            bar['minimized'].set_visible(bool(rows) and self.config.getboolean('panel','show_tasks'))
            bar['empty_space'].set_visible(not rows or not self.config.getboolean('panel','show_tasks'))
            bar['title'].set_visible(self.config.getboolean('panel','show_title'))
            bar['workspace'].set_visible(self.config.getboolean('panel','show_workspaces'))
            bar['audio'].set_visible(self.config.getboolean('panel','show_audio'))
            width = bounds.height if vertical else bounds.width
            bar['session'].set_visible(self.config.getboolean('panel','show_session'))
            bar['metrics'].set_visible(width >= 1000 and self.config.getboolean('panel', 'metrics'))
            bar['clock'].set_visible(self.config.getboolean('panel', 'clock'))
            title = (output_state.get('app_id') or output_state.get('title') or 'Desktop') if self.argent else output_state.get('title') or 'Desktop'
            if self.argent:title = title.removeprefix('org.').split('.')[-1]
            bar['title'].set_label('W' if vertical else (title+' '+bar['arrow']).strip())
            bar['title'].set_tooltip_text(output_state.get('title') or 'Window actions')
            bar['workspace'].set_label(str(output_state.get('workspace', 0)+1)+('' if vertical else ' '+bar['arrow']))
            clock_format=self.config.get('panel','clock_format').strip() or ('%a %H:%M' if self.argent and not vertical else '%H:%M')
            bar['clock'].set_label(datetime.now().astimezone().strftime(clock_format)+('' if vertical else ' '+bar['arrow']))
            bar['clock'].get_child().set_angle(90 if vertical else 0)
            widget = bar['battery']
            widget.set_visible(power.get('present', False) and self.config.getboolean('power','show_battery'))
            percent=power.get('percent')
            level='?' if percent is None else str(percent)+'%'
            suffix=' +' if power.get('status')=='Charging' else ' AC' if power.get('on_ac') else ''
            severity=api['battery_severity'](power,self.config.getint('power','low_percent'),self.config.getint('power','critical_percent'))
            widget.set_label(('' if vertical or self.argent else 'BAT ')+level+suffix+(' !' if severity else '')+('' if vertical else ' '+bar['arrow']))
            widget.get_child().set_angle(90 if vertical else 0)
            widget.set_tooltip_text(level+' — '+power.get('status','Unknown'))
            context=widget.get_style_context()
            for name,active in (('battery-low',severity==1),('battery-critical',severity==2)):
                if active:context.add_class(name)
                else:context.remove_class(name)
        return True

    def metrics(self):
        if self.polling:
            return True
        self.polling = True
        def read():
            telemetry = ''
            audio = 'Audio'
            try:
                values = [int(value) for value in Path('/proc/stat').read_text().splitlines()[0].split()[1:9]]
                total = sum(values);idle = values[3]+values[4]
                cpu = 0 if self.last_cpu is None or total == self.last_cpu[0] else round(100*(1-(idle-self.last_cpu[1])/(total-self.last_cpu[0])))
                self.last_cpu = (total, idle)
                memory = {line.split(':')[0]:int(line.split()[1]) for line in Path('/proc/meminfo').read_text().splitlines() if ':' in line}
                used = (memory['MemTotal']-memory['MemAvailable'])/(1024*1024)
                telemetry = f'CPU {cpu}%  RAM {used:.1f}G'
            except (OSError, ValueError, KeyError):
                pass
            try:
                level, muted = api['volume']()
                audio = 'MUTE' if muted else f'VOL {level}%'
            except Exception:
                pass
            GLib.idle_add(self.update_metrics, telemetry, audio)
        threading.Thread(target=read, daemon=True).start()
        return True

    def update_metrics(self, telemetry, audio):
        self.polling = False
        for bar in self.bars:
            bar['metrics'].set_label(('S' if bar['vertical'] else telemetry+' '+bar['arrow']) if self.config.getboolean('panel', 'metrics') else '')
            bar['metrics'].set_tooltip_text(telemetry or 'System status')
            if self.argent:
                icon=bar['audio'].get_image()
                icon.set_from_icon_name('audio-volume-muted-symbolic' if audio=='MUTE' else 'audio-volume-high-symbolic',Gtk.IconSize.MENU)
                icon.set_pixel_size(18)
            else:bar['audio'].set_label('V' if bar['vertical'] else audio+' '+bar['arrow'])
            bar['audio'].set_tooltip_text(audio)
        return False


class AudioMixer:
    """Refresh off the GTK thread; keep widgets stable while sliders are dragged."""
    def __init__(self, parent, scroll):
        self.scroll = scroll
        self.max_height=scroll.get_max_content_height()
        self.box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=1)
        self.box.get_style_context().add_class('audio-mixer')
        parent.pack_start(self.box, True, True, 0)
        self.provider=Gtk.CssProvider()
        self.provider.load_from_data(api['overlay_style']('audio.css',settings()).encode())
        Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(),self.provider,Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION+2)
        self.alive = True
        self.busy = False
        self.signature = None
        self.rows = {}
        self.values = {}
        self.pending = {}
        self.edits = {}
        self.changed = {}
        self.dragging = set()
        self.box.connect('destroy', self.destroy)
        self.status = Gtk.Label(label='Loading audio devices…', xalign=0)
        self.box.add(self.status)
        self.refresh()
        self.timer = GLib.timeout_add_seconds(2, self.refresh)

    def destroy(self, *args):
        self.alive = False
        GLib.source_remove(self.timer)
        for source in self.pending.values():GLib.source_remove(source)
        for message in self.edits.values():send('audio-control', **message)
        self.pending.clear();self.edits.clear()
        Gtk.StyleContext.remove_provider_for_screen(Gdk.Screen.get_default(),self.provider)

    def refresh(self):
        if not self.alive:return False
        if not self.busy:
            self.busy = True
            def read():
                try:result, error = api['audio_snapshot'](), None
                except Exception as exception:result, error = [], str(exception)
                GLib.idle_add(self.update, result, error)
            threading.Thread(target=read, daemon=True).start()
        return True

    def edit(self, key, operation, value):
        if operation=='volume' and key in self.values:self.values[key].set_text(str(value)+'%')
        self.changed[key] = time.monotonic()
        token = (key, operation)
        self.edits[token] = dict(kind=key[0], id=key[1], operation=operation, value=value)
        if token in self.pending:return
        def commit():
            self.pending.pop(token, None)
            send('audio-control', **self.edits.pop(token))
            return False
        self.pending[token] = GLib.timeout_add(100, commit)

    def release(self, key):
        self.dragging.discard(key)
        token = (key, 'volume')
        if token in self.pending:
            GLib.source_remove(self.pending.pop(token))
            send('audio-control', **self.edits.pop(token))
        return False

    def update(self, groups, error):
        self.busy = False
        if not self.alive:return False
        signature = tuple((title, tuple((r['kind'], r['id'], r['label'], r['adjustable']) for r in rows)) for title, rows in groups)
        if error:
            if self.signature is None:
                self.status.set_text('Audio unavailable. Check PipeWire Pulse / pactl.')
                self.status.set_line_wrap(True)
                self.status.set_tooltip_text(error)
            return False
        if signature != self.signature:
            # Avoid removing a control while it owns a pointer grab.
            if self.dragging:return False
            self.signature = signature
            for widget in self.box.get_children():widget.destroy()
            self.rows.clear()
            self.values.clear()
            for title, rows in groups:
                label = Gtk.Label(label=title, xalign=0)
                label.get_style_context().add_class('audio-group')
                label.set_margin_start(8);label.set_margin_end(8)
                label.set_margin_top(8);label.set_margin_bottom(2)
                self.box.pack_start(label, False, False, 0)
                if not rows:
                    empty=Gtk.Label(label='None active',xalign=0)
                    empty.get_style_context().add_class('audio-empty')
                    empty.set_margin_start(8);empty.set_margin_bottom(6)
                    self.box.pack_start(empty,False,False,0)
                for row in rows:
                    key = (row['kind'], row['id'])
                    card=Gtk.Box(orientation=Gtk.Orientation.VERTICAL,spacing=4)
                    card.get_style_context().add_class('audio-row')
                    card.set_margin_start(8);card.set_margin_end(8)
                    card.set_margin_top(4);card.set_margin_bottom(6)
                    header=Gtk.Box(spacing=6)
                    label = Gtk.Label(label=row['label'], xalign=0)
                    label.set_ellipsize(3);label.set_width_chars(1);label.set_max_width_chars(26)
                    label.set_tooltip_text(row['label'])
                    header.pack_start(label,True,True,0)
                    default = None
                    if row['kind'] in ('sink', 'source'):
                        default = Gtk.Button(label='Use')
                        default.set_tooltip_text('Use as the default '+('output' if row['kind']=='sink' else 'input'))
                        default.connect('clicked', lambda widget, key=key:self.edit(key, 'default', True))
                        header.pack_start(default, False, False, 0)
                    mute = Gtk.ToggleButton(label='Mute')
                    mute.set_tooltip_text('Mute or unmute '+row['label'])
                    handler = mute.connect('toggled', lambda widget, key=key:self.edit(key, 'mute', widget.get_active()))
                    header.pack_start(mute, False, False, 0)
                    card.pack_start(header,False,False,0)
                    line=Gtk.Box(spacing=8)
                    slider = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, 100, 1)
                    slider.set_draw_value(False)
                    slider.set_sensitive(row['adjustable'])
                    slider.set_tooltip_text('Volume for '+row['label'])
                    volume_handler = slider.connect('value-changed', lambda widget, key=key:self.edit(key, 'volume', round(widget.get_value())))
                    slider.connect('button-press-event', lambda widget, event, key=key:self.dragging.add(key) or False)
                    slider.connect('button-release-event', lambda widget, event, key=key:self.release(key))
                    line.pack_start(slider,True,True,0)
                    value=Gtk.Label(label='100%',xalign=1)
                    value.set_width_chars(4);value.set_size_request(38,-1)
                    value.get_style_context().add_class('audio-value')
                    self.values[key]=value
                    line.pack_start(value,False,False,0)
                    card.pack_start(line,False,False,0)
                    self.box.pack_start(card,False,False,0)
                    self.rows[key] = (slider, volume_handler, mute, handler, default)
            self.box.show_all()
            height = self.box.get_preferred_height()[1]
            if height>self.max_height:
                # Open on complete rows rather than half a device or a stranded
                # section heading. Further rows remain reachable by scrolling.
                end=0;boundaries=[]
                for child in self.box.get_children():
                    end+=child.get_preferred_height()[1]+self.box.get_spacing()
                    context=child.get_style_context()
                    if end<=self.max_height and (context.has_class('audio-row') or context.has_class('audio-empty')):
                        boundaries.append(end)
                height=max(boundaries) if boundaries else self.max_height
            self.scroll.set_min_content_height(0)
            self.scroll.set_max_content_height(height)
            self.scroll.set_min_content_height(height)
        for _, rows in groups:
            for row in rows:
                key = (row['kind'], row['id'])
                if key in self.dragging or time.monotonic()-self.changed.get(key, 0)<1:continue
                slider, handler, mute, mute_handler, default = self.rows[key]
                slider.handler_block(handler);slider.set_value(min(100, row['volume']));slider.handler_unblock(handler)
                self.values[key].set_text(str(round(slider.get_value()))+'%')
                mute.handler_block(mute_handler);mute.set_active(row['mute']);mute.handler_unblock(mute_handler)
                if default:
                    default.set_label('Default' if row['default'] else 'Use')
                    default.set_sensitive(not row['default'])
        return False


class DesktopMenu:
    def __init__(self, x, y, page='Desktop', detail='', edge='point'):
        self.edge = edge
        display = Gdk.Display.get_default()
        monitor = display.get_monitor(0)
        for index in range(display.get_n_monitors()):
            candidate = display.get_monitor(index)
            rect = candidate.get_geometry()
            if rect.x <= x < rect.x+rect.width and rect.y <= y < rect.y+rect.height:
                monitor = candidate;break
        rect = monitor.get_geometry()
        self.window = layer_window('madway-menu', monitor, Layer.Layer.OVERLAY, Layer.KeyboardMode.EXCLUSIVE)
        self.window.get_style_context().add_class('menu-popup')
        self.window.set_resizable(False)
        Layer.set_exclusive_zone(self.window, -1)
        Layer.set_anchor(self.window, Layer.Edge.TOP, True)
        Layer.set_anchor(self.window, Layer.Edge.LEFT, True)
        Layer.set_margin(self.window, Layer.Edge.LEFT, min(max(0, int(x-rect.x)), max(0, rect.width-204)))
        Layer.set_margin(self.window, Layer.Edge.TOP, min(max(0, int(y-rect.y)), max(0, rect.height-240)))
        self.container = Gtk.Box(spacing=0)
        self.window.add(self.container)
        self.box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        self.box.get_style_context().add_class('menu')
        self.box.set_size_request(200, -1)
        self.box.set_valign(Gtk.Align.END if edge == 'bottom' else Gtk.Align.START)
        self.container.pack_start(self.box, True, True, 0)
        self.submenu = None
        self.hover_source = 0
        self.window.connect('destroy', self.cleanup)
        self.available_width = rect.width
        self.available_height = rect.height
        self.origin_y = max(0, int(y-rect.y))
        self.window.connect('size-allocate', self.keep_on_output)
        self.origin_x = max(0, int(x-rect.x))
        self.window.set_size_request(200, -1)
        self.window.connect('destroy', Gtk.main_quit)
        self.window.connect('key-press-event', self.key)
        self.buttons = []
        self.page = page
        self.detail = detail
        self.show_page(page)
        self.window.show_all()

    def keep_on_output(self, widget, allocation):
        for edge, origin, limit, size in ((Layer.Edge.LEFT, self.origin_x, self.available_width, allocation.width),
                                          (Layer.Edge.TOP, self.origin_y, self.available_height, allocation.height)):
            if (edge == Layer.Edge.LEFT and self.edge == 'right') or (edge == Layer.Edge.TOP and self.edge == 'bottom'):
                origin -= size
            margin = max(0, min(origin, max(0, limit-size)))
            if Layer.get_margin(self.window, edge) != margin:Layer.set_margin(self.window, edge, margin)

    def cleanup(self, *args):
        if self.hover_source:GLib.source_remove(self.hover_source)
        self.hover_source = 0

    def hover(self, page):
        if self.hover_source:GLib.source_remove(self.hover_source)
        def reveal():
            self.hover_source = 0
            if page:self.open_submenu(page)
            else:self.close_submenu()
            return False
        self.hover_source = GLib.timeout_add(140, reveal)
        return False

    def close_submenu(self):
        if self.submenu:
            self.submenu.destroy();self.submenu = None
        self.page = 'Desktop'
        self.buttons = self.root_buttons[:]
        self.window.resize(200, 1)

    def open_submenu(self, page):
        self.close_submenu()
        self.submenu = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        self.submenu.get_style_context().add_class('menu')
        self.submenu.set_size_request(200, -1)
        self.submenu.set_valign(Gtk.Align.END if self.edge == 'bottom' else Gtk.Align.START)
        # Keep the popup entirely on its output, including near the right edge.
        left = max(0, min(self.origin_x, self.available_width-404))
        Layer.set_margin(self.window, Layer.Edge.LEFT, left)
        self.container.pack_start(self.submenu, False, False, 0)
        if self.edge == 'right':self.container.reorder_child(self.submenu, 0)
        original = self.box
        self.box = self.submenu
        self.render_page(page)
        self.box = original
        self.container.show_all()
        self.window.resize(1, 1)

    def activate(self, name, **values):
        send(name, **values)
        self.window.destroy()

    def show_page(self, page):
        self.window.set_size_request(min(340,self.available_width) if page == 'Audio' else 200, -1)
        if self.submenu:self.close_submenu()
        self.render_page(page)
        if page == 'Desktop':self.root_buttons = self.buttons[:]

    def render_page(self, page):
        self.page = page
        context=self.box.get_style_context()
        if page=='Audio':context.add_class('audio-menu')
        else:context.remove_class('audio-menu')
        for widget in self.box.get_children():
            widget.destroy()
        self.buttons.clear()
        label = Gtk.Label(label=api['panel_label']() if page == 'Desktop' else page, xalign=0)
        label.get_style_context().add_class('menu-title')
        self.box.pack_start(label, False, False, 0)
        def item(label, callback, enabled=True, submenu=None):
            button = Gtk.Button(label=label)
            button.set_halign(Gtk.Align.FILL)
            button.get_child().set_xalign(0)
            button.connect('clicked', lambda widget: callback())
            button.submenu_page = submenu
            if page == 'Desktop':
                button.add_events(Gdk.EventMask.ENTER_NOTIFY_MASK | Gdk.EventMask.LEAVE_NOTIFY_MASK)
                button.connect('enter-notify-event', lambda widget, event:self.hover(submenu))
                button.connect('leave-notify-event', lambda widget, event:self.cleanup())
            self.box.pack_start(button, False, False, 0)
            button.set_sensitive(enabled)
            if enabled:self.buttons.append(button)
        if page not in {'Desktop','Application'}:
            item('‹ Back', lambda: self.show_page('Desktop'))
        if page == 'Desktop':
            item('Applications ›', lambda: self.open_submenu('Applications'), submenu='Applications')
            item('Run command…', lambda: self.activate('run'))
            item('Konsole terminal', lambda: self.activate('terminal'))
            for label in ('Settings', 'Window', 'Workspaces', 'Session'):
                item(label+' ›', lambda label=label: self.open_submenu(label), submenu=label)
            item('Reload settings', lambda: self.activate('apply'))
            item('Demoscenes ›', lambda:self.open_submenu('Demoscenes'), submenu='Demoscenes')
            item('Screenshot ›',lambda:self.open_submenu('Screenshot'),submenu='Screenshot')
            visible=api['settings']().getboolean('desktop','icons')
            item('Hide desktop icons' if visible else 'Show desktop icons',lambda:self.activate('toggle-desktop-icons'))
        elif page == 'Screenshot':
            item('Entire desktop · Print',lambda:self.activate('screenshot'))
            item('Select area · Shift+Print',lambda:self.activate('screenshot-region'))
            item('Copy desktop · Ctrl+Print',lambda:self.activate('screenshot-clipboard'))
        elif page == 'Demoscenes':
            scenes = api['demoscenes']()
            if not scenes:item('No local demoscenes installed', lambda:None, enabled=False)
            for identity, entry in scenes.items():
                item(entry['title'], lambda identity=identity:self.activate('overlay-start', scene=identity))
            item('Stop demoscene', lambda:self.activate('overlay-stop'))
            item('Demoscene settings…', lambda:self.activate('settings-page', page='Session'))
        elif page == 'Applications':
            item('Search applications…', lambda:self.activate('launcher'))
            scroll = Gtk.ScrolledWindow()
            scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
            scroll.set_max_content_height(max(60, min(300, self.available_height-90)));scroll.set_propagate_natural_height(True)
            app_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
            scroll.add(app_box)
            self.box.pack_start(scroll, True, True, 0)
            for app in sorted((app for app in Gio.AppInfo.get_all() if app.should_show()), key=lambda app:app.get_display_name().casefold()):
                identity = app.get_id()
                if not identity:continue
                widget = Gtk.Button(label=app.get_display_name())
                widget.get_child().set_xalign(0)
                widget.get_child().set_ellipsize(3);widget.get_child().set_max_width_chars(28)
                widget.connect('clicked', lambda widget, identity=identity:self.activate('launch-app', id=identity))
                app_box.pack_start(widget, False, False, 0)
                self.buttons.append(widget)
            app_box.show_all()
            scroll.set_min_content_height(min(scroll.get_max_content_height(), app_box.get_preferred_height()[1]))
        elif page == 'Settings':
            scroll=Gtk.ScrolledWindow();scroll.set_policy(Gtk.PolicyType.NEVER,Gtk.PolicyType.AUTOMATIC)
            scroll.set_max_content_height(max(80,min(420,self.available_height-100)));scroll.set_propagate_natural_height(True)
            content=Gtk.Box(orientation=Gtk.Orientation.VERTICAL,spacing=0);scroll.add(content)
            self.box.pack_start(scroll,True,True,0)
            original=self.box;self.box=content
            for group,pages in api['SETTINGS_GROUPS'].items():
                heading=Gtk.Label(label=group,xalign=0);heading.get_style_context().add_class('menu-info');content.add(heading)
                for name in pages:item(name,lambda name=name:self.activate('settings-page',page=name))
            self.box=original;content.show_all()
            scroll.set_min_content_height(min(scroll.get_max_content_height(),content.get_preferred_height()[1]))
        elif page == 'Window':
            try:
                state = json.loads((runtime_directory()/'desktop.json').read_text())
            except (OSError, ValueError):
                state = {}
            has_window = state.get('has_window', bool(state.get('title')))
            for label, command in [('Floating / tiled', 'floating'), ('Minimize', 'minimize'), ('Maximize / restore', 'maximize'), ('Fullscreen', 'fullscreen'), ('Close window', 'close')]:
                item(label, lambda command=command: self.activate('window-'+command), enabled=has_window)
            focused=next((row for row in state.get('windows',[]) if row.get('focused')),None)
            tiled=lambda row:row and not any(row.get(key,False) for key in ('floating','maximized','fullscreen','minimized'))
            if tiled(focused):
                item('Make master · Alt+Shift+Enter',lambda:self.activate('tile',direction='master'))
                for row in state.get('windows',[]):
                    if row['id']!=focused['id'] and tiled(row):
                        item('Swap tile with '+(row.get('title') or 'Untitled')[:32],lambda identity=row['id']:self.activate('tile-swap',id=identity))
            item(('✓ ' if state.get('keep_above') else '')+'Keep above others', lambda:self.activate('window-above'), enabled=has_window)
            for row in state.get('windows', []):
                if row.get('minimized'):
                    item('Restore '+(row.get('title') or 'window'), lambda identity=row['id']:self.activate('switcher-select', id=identity))
        elif page == 'Workspaces':
            for number in range(9):
                item('Workspace '+str(number+1), lambda number=number: self.activate('workspace', value=number))
        elif page == 'Audio':
            self.window.set_size_request(min(340,self.available_width), -1)
            scroll = Gtk.ScrolledWindow()
            scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
            scroll.set_overlay_scrolling(False)
            scroll.set_max_content_height(max(60, min(360, self.available_height-90)));scroll.set_propagate_natural_height(True)
            content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
            scroll.add(content)
            self.box.pack_start(scroll, True, True, 0)
            self.mixer = AudioMixer(content, scroll)
            item('Audio options…', lambda: self.activate('settings-page', page='Audio & brightness'))
            self.box.get_children()[-1].get_style_context().add_class('audio-footer')
        elif page == 'Status':
            label = Gtk.Label(label=self.detail.removesuffix(' ▾') or 'System status', xalign=0)
            label.get_style_context().add_class('menu-info')
            self.box.pack_start(label, False, False, 0)
            item('Panel options…', lambda: self.activate('settings-page', page='Panel'))
            item('Session options…', lambda: self.activate('settings-page', page='Session'))
        elif page == 'Battery':
            state=api['power_snapshot']()
            def info(text):
                label=Gtk.Label(label=text,xalign=0,wrap=True)
                label.set_max_width_chars(32);label.get_style_context().add_class('menu-info')
                self.box.pack_start(label,False,False,0)
            if not state.get('present'):info('No system battery detected')
            else:
                percent=state.get('percent')
                info(('Level unavailable' if percent is None else str(percent)+'%')+' — '+state.get('status','Unknown'))
                info('External power: '+('Connected' if state.get('on_ac') is True else 'Disconnected' if state.get('on_ac') is False else 'Unknown'))
                seconds=state.get('seconds')
                if seconds is not None:
                    minutes=round(seconds/60);hours,minutes=divmod(minutes,60)
                    duration=(str(hours)+'h ' if hours else '')+str(minutes)+'m'
                    info('Estimated '+duration+(' to full' if state.get('status')=='Charging' else ' remaining'))
                if len(state.get('batteries',[]))>1:
                    for row in state['batteries']:
                        info(row['name']+': '+('?' if row['percent'] is None else str(row['percent'])+'%')+' — '+row['status'])
            def refresh_power():
                send('power-refresh')
                def reload():
                    if self.window.get_visible() and self.page=='Battery':self.show_page('Battery')
                    return False
                GLib.timeout_add(250,reload)
            item('Refresh',refresh_power)
            item('Power settings…',lambda:self.activate('settings-page',page='Power'))
        elif page == 'Clock':
            label = Gtk.Label(label=datetime.now().astimezone().strftime('%a %d %b %Y'), xalign=0)
            label.get_style_context().add_class('menu-info')
            self.box.pack_start(label, False, False, 0)
            calendar=Gtk.Calendar()
            calendar.set_display_options(Gtk.CalendarDisplayOptions.SHOW_HEADING | Gtk.CalendarDisplayOptions.SHOW_DAY_NAMES | Gtk.CalendarDisplayOptions.SHOW_WEEK_NUMBERS)
            today=datetime.now().astimezone()
            calendar.select_month(today.month-1,today.year);calendar.select_day(today.day);calendar.mark_day(today.day)
            def mark_today(widget):
                year,month,day=widget.get_date();widget.clear_marks()
                if (year,month)==(today.year,today.month-1):widget.mark_day(today.day)
            calendar.connect('month-changed',mark_today)
            self.box.pack_start(calendar,False,False,0)
            item('Today',lambda:(calendar.select_month(datetime.now().month-1,datetime.now().year),calendar.select_day(datetime.now().day)))
            item('Date & time settings…', lambda: self.activate('settings-page', page='Date & time'))
            item('Clock options…', lambda: self.activate('settings-page', page='Panel'))
        elif page=='Application':
            apps=runpy.run_path(str(Path(__file__).with_name('madway_apps.py')))
            try:state=json.loads((runtime_directory()/'desktop.json').read_text())
            except (OSError,ValueError):state={}
            identity=int(self.detail) if self.detail.isdigit() else 0
            row=next((row for row in state.get('all_windows',state.get('windows',[])) if row['id']==identity),{})
            app_id=row.get('app_id',self.detail if not identity else '')
            app=apps['resolve'](app_id);desktop_id=app.get_id() if app else app_id
            pinned=desktop_id in apps['pins'](settings())
            label.set_text(app.get_display_name() if app else row.get('title') or 'Application')
            item('Remove from Dock' if pinned else 'Keep in Dock',
                lambda:self.activate('dock-unpin' if pinned else 'dock-pin',app_id=desktop_id),enabled=bool(app) or pinned)
            item('Open another window' if row else 'Open application',lambda:self.activate('dock-launch',app_id=desktop_id,new=True),enabled=bool(app))
            if row:
                item('Restore' if row.get('minimized') else 'Minimize',lambda:self.activate('taskbar-toggle',id=identity))
                item('Close window',lambda:self.activate('window-close',id=identity))
                focused=next((entry for entry in state.get('windows',[]) if entry.get('focused')),None)
                if focused and focused['id']!=identity and focused.get('output')==row.get('output') and focused.get('workspace')==row.get('workspace') and not any(entry.get(key,False) for entry in (row,focused) for key in ('floating','minimized','fullscreen','maximized')):
                    item('Swap tile with focused window',lambda:self.activate('tile-swap',id=identity))
            item('Dock settings…',lambda:self.activate('settings-page',page='Dock'))
        elif page == 'Session':
            item('Lock screen',lambda:self.activate('lock'))
            item('Sleep',lambda:self.activate('sleep'),enabled=os.environ.get('MADWAY_NATIVE')=='1')
            item('Log out…', lambda: self.activate('session-confirm',operation='logout'))
            item('Restart computer…',lambda:self.activate('session-confirm',operation='reboot'))
            item('Shut down computer…',lambda:self.activate('session-confirm',operation='poweroff'))
            item('Session settings…', lambda: self.activate('settings-page', page='Session'))
        self.box.show_all()
        if self.buttons:self.buttons[0].grab_focus()

    def key(self, window, event):
        key = Gdk.keyval_name(event.keyval)
        if key == 'Escape':
            self.window.destroy();return True
        if isinstance(self.window.get_focus(), Gtk.Range) and key in ('Left', 'Right', 'Up', 'Down', 'Home', 'End'):
            return False
        if isinstance(self.window.get_focus(),Gtk.Calendar) and key in ('Left','Right','Up','Down','Page_Up','Page_Down','Home','End','Return','space'):
            return False
        if key == 'Left' and self.page != 'Desktop':
            if self.submenu:self.close_submenu()
            else:self.show_page('Desktop')
            self.buttons[0].grab_focus();return True
        if key == 'Right':
            page = getattr(self.window.get_focus(), 'submenu_page', None)
            if page:self.open_submenu(page);return True
        if key in ('Up', 'Down'):
            focused = self.window.get_focus()
            index = self.buttons.index(focused) if focused in self.buttons else -1
            self.buttons[(index+(1 if key == 'Down' else -1))%len(self.buttons)].grab_focus()
            return True
        if key in ('Return', 'KP_Enter') and self.window.get_focus() in self.buttons:
            self.window.get_focus().clicked();return True
        return False


class MediaIndicator:
    def __init__(self,resident=False):
        import cairo
        self.cairo=cairo;self.config=settings();self.closed=False;self.tick_id=0;self.poll_id=0;self.serial=None
        self.resident=resident;self.active=False;self.monitor=None;self.watcher=None
        self.visual=0.;self.origin=0.;self.target=0.;self.started=0.;self.deadline=0.
        try:data=json.loads((runtime_directory()/'media.json').read_text())
        except (OSError,ValueError):data=None
        initial=data or {}
        display=Gdk.Display.get_default();monitor=display.get_monitor_at_point(initial.get('output_x',0),initial.get('output_y',0)) or display.get_monitor(0)
        self.window=layer_window('madway-osd',monitor,Layer.Layer.OVERLAY,Layer.KeyboardMode.NONE)
        self.monitor=monitor
        self.window.get_style_context().add_class('media-window')
        Layer.set_anchor(self.window,Layer.Edge.BOTTOM,True);Layer.set_margin(self.window,Layer.Edge.BOTTOM,76)
        Layer.set_exclusive_zone(self.window,-1)
        self.provider=Gtk.CssProvider();self.provider.load_from_data(api['overlay_style']('osd.css',self.config).encode())
        Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(),self.provider,Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION+2)
        row=Gtk.Box(spacing=12);row.get_style_context().add_class('media-card');self.window.add(row)
        self.icon=Gtk.Image();self.icon.set_pixel_size(26);row.pack_start(self.icon,False,False,0)
        content=Gtk.Box(orientation=Gtk.Orientation.VERTICAL,spacing=8);row.pack_start(content,True,True,0)
        header=Gtk.Box(spacing=12);self.label=Gtk.Label(xalign=0);header.pack_start(self.label,True,True,0)
        self.value=Gtk.Label();self.value.get_style_context().add_class('media-value');header.pack_start(self.value,False,False,0)
        content.pack_start(header,False,False,0)
        self.canvas=Gtk.DrawingArea();self.canvas.set_size_request(180,5);self.canvas.connect('draw',self.draw)
        content.pack_start(self.canvas,False,False,0)
        self.window.connect('realize',lambda window:window.get_window().input_shape_combine_region(cairo.Region(),0,0))
        self.window.connect('destroy',self.finish)
        if resident:
            # Resolve the initial fonts, icon and native surface before a key
            # press, without mapping any visible indicator at session startup.
            self.icon.set_from_icon_name('audio-volume-high-symbolic',Gtk.IconSize.DIALOG)
            self.label.set_text('Volume');self.value.set_text('100%')
            row.show_all();self.window.realize();self.window.get_preferred_size()
            self.watcher=Gio.File.new_for_path(str(runtime_directory())).monitor_directory(Gio.FileMonitorFlags.WATCH_MOVES,None)
            def changed(watch,file,other,event):
                if file.get_basename() in {'media.json','desktop.json'} or (other and other.get_basename()=='media.json'):self.poll(force=True)
            self.watcher.connect('changed',changed)
            self.poll_id=GLib.timeout_add(100,self.poll)
            if data and time.monotonic()-data.get('serial',0)/1e9<1.3:self.poll(force=True)
        else:
            self.window.show_all()
            if data:self.update(data)
            self.poll_id=GLib.timeout_add(24,self.poll)

    @staticmethod
    def ease(progress):
        if progress<=0:return 0.
        if progress>=1:return 1.
        low=0.;high=1.
        for _ in range(18):
            t=(low+high)*.5;u=1-t
            if 3*u*u*t*.32+3*u*t*t*.18+t*t*t<progress:low=t
            else:high=t
        t=(low+high)*.5;return t*t*(3-2*t)

    def current(self,now):
        duration=max(.08,min(.6,self.config.getint('motion','media_ms')/1000))
        return self.origin+(self.target-self.origin)*self.ease((now-self.started)/duration)

    def update(self,data):
        if self.resident:
            first=not self.active
            display=Gdk.Display.get_default()
            monitor=display.get_monitor_at_point(data.get('output_x',0),data.get('output_y',0)) or display.get_monitor(0)
            if monitor is not self.monitor:
                if self.active:self.window.hide()
                Layer.set_monitor(self.window,monitor);self.monitor=monitor
            if first:
                value=data.get('previous')
                if value is None:value=0. if data.get('muted') else float(data['value'])
                self.visual=self.origin=self.target=float(value)
            self.active=True;self.window.show_all()
        now=time.monotonic();self.visual=self.current(now);self.origin=self.visual
        self.target=0. if data.get('muted') else float(data['value']);self.started=now
        self.serial=data['serial'];self.deadline=now+1.3
        muted=data.get('muted');volume=data['kind']=='volume'
        self.icon.set_from_icon_name('audio-volume-muted-symbolic' if muted else 'audio-volume-high-symbolic' if volume else 'display-brightness-symbolic',Gtk.IconSize.DIALOG)
        self.label.set_text('Muted' if muted else 'Volume' if volume else 'Display brightness')
        self.value.set_text('…' if data.get('pending') else str(data['value'])+'%')
        if not self.config.getboolean('motion','effects'):self.visual=self.target;self.canvas.queue_draw()
        elif not self.tick_id:self.tick_id=self.canvas.add_tick_callback(self.tick)

    def tick(self,widget,clock):
        if self.closed:return False
        self.visual=self.current(time.monotonic());self.canvas.queue_draw()
        if abs(self.visual-self.target)<.01:self.visual=self.target;self.tick_id=0;return False
        return True

    def draw(self,widget,cr):
        palette=api['palette'](self.config)
        def color(value,alpha):
            cr.set_source_rgba(*[int(value[index:index+2],16)/255 for index in (1,3,5)],alpha)
        width=max(1,widget.get_allocated_width()-4);height=widget.get_allocated_height()
        cr.set_line_width(4);cr.set_line_cap(self.cairo.LINE_CAP_ROUND)
        color(palette['border'],.35);cr.move_to(2,height/2);cr.line_to(width+2,height/2);cr.stroke()
        if self.visual>0:
            color(palette['accent'],1);cr.move_to(2,height/2);cr.line_to(2+width*min(100,self.visual)/100,height/2);cr.stroke()
        return False

    def poll(self,force=False):
        if self.closed:return False
        if self.resident and not self.active and not force:return True
        try:
            state=json.loads((runtime_directory()/'desktop.json').read_text())
            data=json.loads((runtime_directory()/'media.json').read_text())
            if self.resident and time.monotonic()-data.get('serial',0)/1e9>1.5:
                self.serial=data.get('serial');self.hide();return True
            if state.get('locked') or state.get('sleeping'):
                self.serial=data.get('serial');self.hide();return self.resident
            if data['serial']!=self.serial:self.update(data)
        except (OSError,ValueError,KeyError):pass
        if time.monotonic()>=self.deadline:self.hide();return self.resident
        return True

    def hide(self):
        if not self.resident:self.window.destroy();return
        self.active=False;self.window.hide()
        if self.tick_id:self.canvas.remove_tick_callback(self.tick_id);self.tick_id=0

    def finish(self,*args):
        self.closed=True
        if self.watcher:self.watcher.cancel();self.watcher=None
        if self.tick_id:self.canvas.remove_tick_callback(self.tick_id);self.tick_id=0
        if self.poll_id:GLib.source_remove(self.poll_id);self.poll_id=0
        Gtk.StyleContext.remove_provider_for_screen(Gdk.Screen.get_default(),self.provider)
        Gtk.main_quit()


class WindowSwitcher:
    def __init__(self):
        display=Gdk.Display.get_default();monitor=display.get_monitor(0)
        try:
            state=json.loads((runtime_directory()/'desktop.json').read_text())
            for index in range(display.get_n_monitors()):
                candidate=display.get_monitor(index);bounds=candidate.get_geometry()
                if bounds.x<=state.get('output_x',0)<bounds.x+bounds.width and bounds.y<=state.get('output_y',0)<bounds.y+bounds.height:
                    monitor=candidate;break
        except (OSError,ValueError):pass
        self.config=settings();self.closed=False;self.refresh_source=0
        self.window=layer_window('madway-switcher',monitor,Layer.Layer.OVERLAY,Layer.KeyboardMode.NONE)
        self.window.get_style_context().add_class('switcher-window')
        Layer.set_exclusive_zone(self.window,-1);self.window.set_resizable(False)
        self.provider=Gtk.CssProvider();self.provider.load_from_data(api['overlay_style']('switcher.css',self.config).encode())
        Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(),self.provider,Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION+2)
        self.box=Gtk.Box(orientation=Gtk.Orientation.VERTICAL,spacing=0)
        self.box.get_style_context().add_class('switcher-surface');self.window.add(self.box)
        bounds=monitor.get_geometry();self.scale=max(1,monitor.get_scale_factor())
        self.preview_width=min(228,max(80,bounds.width-100))
        self.max_height=max(64,min(500,bounds.height-100))
        self.preview_height=min(144,max(32,self.max_height-62))
        self.card_width=self.preview_width+18
        self.columns=max(1,min(5,(bounds.width-64)//(self.card_width+8)))
        self.signature=None;self.previews={};self.cards={};self.focused_id=None
        self.window.connect('destroy',self.finish)
        self.refresh()
        if not self.closed:self.refresh_source=GLib.timeout_add(24,self.refresh)

    def finish(self,*args):
        self.closed=True
        if self.refresh_source:GLib.source_remove(self.refresh_source);self.refresh_source=0
        self.cards.clear();self.previews.clear()
        Gtk.StyleContext.remove_provider_for_screen(Gdk.Screen.get_default(),self.provider)
        Gtk.main_quit()

    def image(self,row):
        key=(row['id'],row.get('preview',0));pixbuf=self.previews.get(key)
        if pixbuf is None and row.get('preview'):
            try:
                pixbuf=GdkPixbuf.Pixbuf.new_from_file_at_scale(str(runtime_directory()/'previews'/f"{row['id']}.png"),
                    self.preview_width*self.scale,self.preview_height*self.scale,True)
                self.previews[key]=pixbuf
            except GLib.Error:pass
        if pixbuf:
            image=Gtk.Image.new_from_surface(Gdk.cairo_surface_create_from_pixbuf(pixbuf,self.scale,None))
        else:
            image=Gtk.Image.new_from_icon_name('application-x-executable',Gtk.IconSize.DIALOG)
        image.set_size_request(self.preview_width,self.preview_height)
        return image

    def build(self,rows):
        for child in self.box.get_children():child.destroy()
        self.cards.clear();self.focused_id=None
        columns=max(1,min(self.columns,len(rows)))
        self.window.set_size_request(columns*(self.card_width+8)+40,-1)
        self.scroll=Gtk.ScrolledWindow()
        self.scroll.set_policy(Gtk.PolicyType.NEVER,Gtk.PolicyType.AUTOMATIC)
        self.scroll.set_max_content_height(self.max_height);self.scroll.set_propagate_natural_height(True)
        self.items=Gtk.Grid(column_spacing=8,row_spacing=8);self.scroll.add(self.items)
        if not rows:self.items.add(Gtk.Label(label='No windows on this workspace'))
        valid={(row['id'],row.get('preview',0)) for row in rows}
        self.previews={key:value for key,value in self.previews.items() if key in valid}
        for index,row in enumerate(rows):
            button=Gtk.Button();button.set_can_focus(False)
            button.get_style_context().add_class('switcher-card')
            card=Gtk.Box(orientation=Gtk.Orientation.VERTICAL,spacing=8);button.add(card)
            card.pack_start(self.image(row),False,False,0)
            app_id=row.get('app_id','')
            try:app=Gio.DesktopAppInfo.new(app_id.removesuffix('.desktop')+'.desktop') if app_id else None
            except (TypeError,GLib.Error):app=None
            app_name=app.get_display_name() if app else app_id.removeprefix('org.').split('.')[-1] or 'Application'
            meta=Gtk.Box(spacing=7)
            icon=Gtk.Image.new_from_gicon(app.get_icon() if app and app.get_icon() else Gio.ThemedIcon.new('application-x-executable'),Gtk.IconSize.MENU)
            icon.set_pixel_size(24);meta.pack_start(icon,False,False,0)
            text=Gtk.Box(orientation=Gtk.Orientation.VERTICAL,spacing=1)
            for value,style in [(app_name,'switcher-app'),('Minimized · '+(row['title'] or 'Untitled') if row.get('minimized') else row['title'] or 'Untitled','switcher-title')]:
                label=Gtk.Label(label=value,xalign=0);label.set_ellipsize(3);label.set_max_width_chars(22)
                label.get_style_context().add_class(style);text.pack_start(label,False,False,0)
            meta.pack_start(text,True,True,0);card.pack_start(meta,False,False,0)
            button.set_tooltip_text(row['title'] or 'Untitled')
            button.connect('clicked',lambda widget,identity=row['id']:send('switcher-select',id=identity))
            self.items.attach(button,index%columns,index//columns,1,1);self.cards[row['id']]=button
        self.box.pack_start(self.scroll,True,True,0)
        footer=Gtk.Box(spacing=7);footer.get_style_context().add_class('switcher-footer')
        self.caption=Gtk.Label(xalign=0);self.caption.set_ellipsize(3);self.caption.set_max_width_chars(80)
        self.caption.get_style_context().add_class('switcher-caption');footer.pack_start(self.caption,True,True,0)
        self.count=Gtk.Label();self.count.get_style_context().add_class('switcher-count');footer.pack_start(self.count,False,False,0)
        hint=Gtk.Label(label=('Super' if self.config.get('input','modifier')=='super' else 'Alt')+' + Tab')
        hint.get_style_context().add_class('switcher-key');footer.pack_start(hint,False,False,0)
        self.box.pack_start(footer,False,False,0);self.window.show_all()
        self.scroll.set_min_content_height(min(self.max_height,self.items.get_preferred_height()[1]))

    def reveal(self):
        if self.closed:return False
        selected=self.cards.get(self.focused_id)
        if not selected or not selected.get_parent():return False
        position=selected.translate_coordinates(self.items,0,0)
        if position:
            adjustment=self.scroll.get_vadjustment();top=position[1];bottom=top+selected.get_allocated_height()
            value=adjustment.get_value()
            if top<value:value=top
            elif bottom>value+adjustment.get_page_size():value=bottom-adjustment.get_page_size()
            adjustment.set_value(max(0,min(value,adjustment.get_upper()-adjustment.get_page_size())))
        return False

    def refresh(self):
        if self.closed:return False
        try:state=json.loads((runtime_directory()/'desktop.json').read_text())
        except (OSError,ValueError):return True
        if not state.get('switcher'):
            self.window.destroy();return False
        rows=state.get('windows',[])
        # Selection changes only update classes/caption, retaining the preview grid.
        signature=tuple((row['id'],row['title'],row.get('app_id',''),row.get('minimized',False),row.get('preview',0)) for row in rows)
        rebuilt=signature!=self.signature
        if rebuilt:self.signature=signature;self.build(rows)
        focused=next((row for row in rows if row.get('focused')),None)
        identity=focused['id'] if focused else None
        if rebuilt or identity!=self.focused_id:
            self.focused_id=identity
            for key,button in self.cards.items():
                context=button.get_style_context()
                if key==identity:context.add_class('selected')
                else:context.remove_class('selected')
            self.caption.set_text(focused['title'] or 'Untitled' if focused else 'Windows')
            self.caption.set_tooltip_text(self.caption.get_text())
            index=next((index+1 for index,row in enumerate(rows) if row['id']==identity),0)
            self.count.set_text(f'{index} / {len(rows)}')
            GLib.idle_add(self.reveal)
        return True


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('mode', choices=['bar', 'menu', 'switcher','osd','spotlight'])
    parser.add_argument('--page', choices=MENU_PAGES, default='Desktop')
    parser.add_argument('--edge', choices=['point','top','bottom','left','right'], default='point')
    parser.add_argument('--detail', default='')
    parser.add_argument('--x', type=int, default=0)
    parser.add_argument('--y', type=int, default=0)
    parser.add_argument('--resident',action='store_true')
    options = parser.parse_args()
    Gtk.Settings.get_default().set_property("gtk-enable-animations", False)
    config=settings();api['icon_theme'](config)
    provider = Gtk.CssProvider();provider.load_from_data((api['theme_style'](CSS.decode(),config)+api['panel_style'](config)).encode())
    Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
    utilities=Gtk.CssProvider();utilities.load_from_data(api['overlay_style']('utilities.css',config).encode())
    Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(),utilities,Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION+3)
    if options.mode=='spotlight':
        source=runpy.run_path(str(Path(__file__).with_name('madway_spotlight.py')))
        component=source['Spotlight'](api,layer_window,send)
    else:component = TopBar() if options.mode == 'bar' else WindowSwitcher() if options.mode == 'switcher' else MediaIndicator(options.resident) if options.mode=='osd' else DesktopMenu(options.x, options.y, options.page, options.detail, options.edge)
    if not isinstance(component,WindowSwitcher) or not component.closed:Gtk.main()


if __name__ == '__main__':
    main()
