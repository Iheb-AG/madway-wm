#!/usr/bin/env python3
"""Compact layer-shell top bars and the shared desktop utility menu."""
import argparse
from datetime import datetime
import json
from pathlib import Path
import runpy
import threading
import time

import gi
gi.require_version('Gtk', '3.0')
gi.require_version('GtkLayerShell', '0.1')
from gi.repository import Gtk, Gdk, Gio, GLib, GtkLayerShell as Layer

api = runpy.run_path(str(Path(__file__).resolve().with_name('madway-shell')))
action = api['action']
settings = api['settings']
runtime_directory = api['runtime_directory']
PAGES = api['SETTINGS_PAGES']
MENU_PAGES = ('Desktop', 'Settings', 'Window', 'Workspaces', 'Audio', 'Status', 'Clock', 'Session')
CSS = b'''
