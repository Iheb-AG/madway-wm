gi.require_version('GdkPixbuf','2.0')
from gi.repository import GdkPixbuf

api = runpy.run_path(str(Path(__file__).resolve().with_name('madway-shell')))
action = api['action']
settings = api['settings']
runtime_directory = api['runtime_directory']
PAGES = api['SETTINGS_PAGES']
MENU_PAGES = ('Desktop', 'Settings', 'Window', 'Workspaces', 'Audio', 'Status', 'Clock', 'Session', 'Demoscenes', 'Battery', 'Screenshot')
