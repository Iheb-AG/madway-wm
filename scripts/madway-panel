window { background: #000000; color: #c8c8c8; }
button { min-width: 0; min-height: 0; padding: 0 4px; margin: 0; border: 0; background: transparent; color: #c8c8c8; box-shadow: none; }
button:hover, button:focus, button.selected { background: #202020; color: #ffffff; }
button.brand { color: #eeeeee; }
.bar.top { border-bottom: 1px solid #282828; }
.bar.bottom { border-top: 1px solid #282828; }
.bar.left { border-right: 1px solid #282828; }
.bar.right { border-left: 1px solid #282828; }
.bar.left button, .bar.right button { padding: 2px 0; }
.menu { background-color: #080808; color: #c8c8c8; border: 1px solid #303030; padding: 1px; }
